{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "step-progress-api",
  "main": "src/v3.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GOOGLE_API_URL": "https://script.google.com/macros/s/AKfycbwu8lfhiH3_7m4ogHNtbgeo3ehx_VBMnt1mPXsvIlL_kMSpxFdrRD4rO_I6q_JUXIWHmg/exec"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "step-progress-db",
      "database_id": "028f097c-2609-4bf7-9e9b-39b565606941"
    }
  ]
}
