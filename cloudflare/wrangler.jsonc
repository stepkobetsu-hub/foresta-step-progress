{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "step-progress-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PRODUCTION_WRITE_APPROVED": "false",
    "TEST_WRITE_APPROVED": "true",
    "DUAL_WRITE_ENABLED": "true",
    "SYNC_BATCH_SIZE": "25",
    "GOOGLE_DUAL_WRITE_URL": "https://script.google.com/macros/s/AKfycbyby9F8K2I3ZWpC-sL_vsNpOw_VwOSVqfWXayFviWwz44kpUlSTJOfmKHxaqD27AcxTBA/exec",
    "GOOGLE_API_URL": "https://script.google.com/macros/s/AKfycbwu8lfhiH3_7m4ogHNtbgeo3ehx_VBMnt1mPXsvIlL_kMSpxFdrRD4rO_I6q_JUXIWHmg/exec",
    "TEST_STUDENT_ID": "TEST-STUDENT-01",
    "ADMIN_API_ENABLED": "false",
    "EMERGENCY_STOP": "false",
    "MIRROR_READ_ENABLED": "true"
  },
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "triggers": {"crons": ["* * * * *"]},
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api", "/health", "/students/*", "/sync/*", "/admin/sync/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "step-progress-db",
      "database_id": "028f097c-2609-4bf7-9e9b-39b565606941",
      "migrations_dir": "migrations"
    }
  ]
}

