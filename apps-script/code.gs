function upsertGradeConflict_(record) {
  const rows = getRowsAsObjects_('GradeConflicts');
  const current = rows.find(row => String(row.studentId) === String(record.studentId) && !row.resolvedAt);
  const next = {
    conflictId: current ? current.conflictId : Utilities.getUuid(),
    studentId: record.studentId,
    name: record.name,
    campus: record.campus,
    gradeJRaw: record.gradeJRaw,
    gradeKRaw: record.gradeKRaw,
    displayGrade: record.displayGrade,
    detectedAt: current ? current.detectedAt : record.detectedAt,
    resolvedAt: '',
    resolvedBy: ''
  };
  if (current) updateObjectRow_('GradeConflicts', current._rowNumber, next);
  else appendObject_('GradeConflicts', next);
}

function listGradeConflicts_(session) {
  requireRole_(session, [ROLE.ADMIN]);
  return getRowsAsObjects_('GradeConflicts')
    .filter(row => !row.resolvedAt)
    .map(row => ({
      conflictId: row.conflictId,
      studentId: row.studentId,
      name: row.name,
      campus: row.campus,
      gradeJRaw: row.gradeJRaw,
      gradeKRaw: row.gradeKRaw,
      displayGrade: row.displayGrade,
      detectedAt: row.detectedAt
    }));
}

function listUnitMaster_(session) {
  requireRole_(session, [ROLE.ADMIN]);
  return getRowsAsObjects_('Units').sort((a, b) =>
    String(a.subject).localeCompare(String(b.subject), 'ja') ||
    String(a.gradeScope).localeCompare(String(b.gradeScope), 'ja') ||
    Number(a.displayOrder || 0) - Number(b.displayOrder || 0)
  ).map(row => {
    const copy = Object.assign({}, row);
    copy.series = normalizeSeries_(row.series);
    copy.seriesLabel = seriesLabel_(row.series);
    copy.hasLct = unitHasLct_(row);
    copy.homeworkItems = homeworkTypesForUnit_(row);
    delete copy._rowNumber;
    return copy;
  });
}

function setStandardRange_(session, input) {
  requireRole_(session, [ROLE.ADMIN]);
  const grade = normalizeGrade_(input.grade);
  const unitId = String(input.unitId || '');
  if (!grade || !unitId) throw publicError_('学年と単元を指定してください。', 'BAD_REQUEST');
  const unit = getRowsAsObjects_('Units').find(row => String(row.unitId) === unitId);
  if (!unit) throw publicError_('単元が見つかりません。', 'UNIT_NOT_FOUND');
  if (String(unit.unitType) === 'PRE_STEP' && input.included) {
    throw publicError_('プレステップは標準範囲へ追加できません。生徒別目標で追加してください。', 'PRE_STEP_STANDARD_FORBIDDEN');
  }
  const rows = getRowsAsObjects_('StandardRanges');
  const current = rows.find(row => String(row.grade) === grade && String(row.unitId) === unitId);
  const now = nowIso_();
  const next = {
    standardRangeId: current ? current.standardRangeId : Utilities.getUuid(),
    masterVersion: MASTER_VERSION,
    grade,
    subject: unit.subject,
    unitId,
    included: !!input.included,
    createdAt: current ? current.createdAt : now,
    updatedAt: now,
    updatedBy: session.userId,
    series: normalizeSeries_(unit.series)
  };
  if (current) updateObjectRow_('StandardRanges', current._rowNumber, next);
  else appendObject_('StandardRanges', next);
  invalidateStaticDataCache_();
  writeAudit_(session, 'SET_STANDARD_RANGE', 'StandardRanges', next.standardRangeId, current, next);
  return {success: true};
}

// ===== Api.gs =====
function doGet() {
  return jsonOutput_({
    success: true,
    service: APP_NAME,
    mode: 'API_ONLY',
    version: 36
  });
}

function doPost(e) {
  const doPostStartedAt = Date.now();
  let input = {};
  const parseStartedAt = Date.now();
  try {
    input = JSON.parse((e.postData && e.postData.contents) || '{}');
  } catch (error) {
    return jsonOutput_({success: false, code: 'INVALID_JSON', error: 'リクエスト形式が正しくありません。'});
  }
  input._requestParseMs = Date.now() - parseStartedAt;
  const result = api(input);
  if (result && result._timing) {
    result._timing.requestParseMs = input._requestParseMs;
    result._timing.doPostBeforeResponseMs = Date.now() - doPostStartedAt;
  }
  if (result && result._timing) {
    const responseStartedAt = Date.now();
    JSON.stringify(result);
    result._timing.responseGenerationMs = Date.now() - responseStartedAt;
    result._timing.measuredServerMs = Date.now() - doPostStartedAt;
  }
  return jsonOutput_(result);
}

// HTML Service から google.script.run で呼び出す唯一の公開RPCです。
function api(input) {
  const requestStartedAt = Date.now();
  const request = input && typeof input === 'object' ? input : {};
  const action = String(request.action || '');
  let session = null;
  requestDb_ = null;
  try {
    const publicResult = routePublicApi_(action, request);
    if (publicResult) return toClientSafe_(publicResult);
    session = verifySession_(request.token);
    return toClientSafe_(routeAuthenticatedApi_(action, request, session));
  } catch (error) {
    if (shouldWriteErrorLog_(error)) writeErrorLog_(action, session, error);
    if (error && error.isPublic) {
      return {success: false, code: error.code || 'BAD_REQUEST', error: error.message};
    }
    return {success: false, code: 'INTERNAL_ERROR', error: '処理に失敗しました。時間をおいて再度お試しください。'};
  } finally {
    perfTrace_('api.complete', requestStartedAt, {action});
    requestDb_ = null;
  }
}

function toClientSafe_(value) {
  if (value instanceof Date) return value.toISOString();
  if (Array.isArray(value)) return value.map(toClientSafe_);
  if (value && typeof value === 'object') {
    return Object.keys(value).reduce((result, key) => {
      const item = value[key];
      if (typeof item !== 'undefined' && typeof item !== 'function') {
        result[key] = toClientSafe_(item);
      }
      return result;
    }, {});
  }
  return value;
}

function routePublicApi_(action, input) {
  if (action === 'studentLogin') {
    const loginStartedAt = Date.now();
    const auth = authenticateStudent_(input.studentId, input.password);
    const authCompletedAt = Date.now();
    const session = createSession_('STUDENT', auth.profile.studentId, auth.role, '');
    const sessionCompletedAt = Date.now();
    authTrace_('auth.sessionCreate', auth.authStartedAt, {student: maskedStudentId_(auth.profile.studentId)});
    const profileSyncStartedAt = Date.now();
    const cachedProfile = getCachedStudentProfile_(auth.profile.studentId);
    const comparedFields = ['name','campus','grade','gradeJRaw','gradeKRaw','gradeConflict','school','enrollmentStatus'];
    const profileChanged = !cachedProfile || comparedFields.some(key =>
      String(cachedProfile[key] == null ? '' : cachedProfile[key]) !==
      String(auth.profile[key] == null ? '' : auth.profile[key])
    );
    if (profileChanged) upsertStudentProfile_(auth.profile);
    else cacheStudentProfile_(Object.assign({}, cachedProfile, auth.profile));
    const profileSyncMs = Date.now() - profileSyncStartedAt;
    authTrace_('auth.profileSync', auth.authStartedAt, {student: maskedStudentId_(auth.profile.studentId), changed: profileChanged});
    authTrace_('auth.complete', auth.authStartedAt, {student: maskedStudentId_(auth.profile.studentId)});
    const timing = Object.assign({}, auth.authTiming || {}, session.timing || {}, {
      authenticationPhaseMs: authCompletedAt - loginStartedAt,
      sessionPhaseMs: sessionCompletedAt - authCompletedAt,
      profileSyncMs,
      profileSyncSkipped: !profileChanged,
      loginCodeTotalMs: Date.now() - loginStartedAt
    });
    console.info(JSON.stringify({
      stage: 'login.breakdown',
      elapsedMs: timing.loginCodeTotalMs,
      cacheHit: timing.idSearchMs === 0,
      profileSyncSkipped: timing.profileSyncSkipped,
      timing
    }));
    return {success: true, profile: auth.profile, role: auth.role, token: session.token, expiresAt: session.expiresAt, _timing: timing};
  }
  if (action === 'staffLogin') {
    const auth = authenticateStaff_(input.code, input.password);
    const session = createSession_('STAFF', auth.profile.staffId, auth.role, auth.permissionLevel);
    return {
      success: true,
      profile: auth.profile,
      role: auth.role,
      permissionLevel: auth.permissionLevel,
      token: session.token,
      expiresAt: session.expiresAt
    };
  }
  if (action === 'logout') {
    logout_(input.token);
    return {success: true};
  }
  return null;
}

function routeAuthenticatedApi_(action, input, session) {
  switch (action) {
    case 'getSession':
      return {success: true, userId: session.userId, role: session.role, permissionLevel: session.permissionLevel};
    case 'getStudentDashboard':
      return {success: true, data: getStudentDashboard_(session, input.studentId)};
    case 'getStudentInputHistory':
      return {success: true, history: getStudentInputHistory_(session, input.studentId, input.limit)};
    case 'saveStudentProgress':
      return saveStudentProgress_(session, input);
    case 'saveStudentProgressBatch':
      return saveStudentProgressBatch_(session, input);
    case 'listVocabularyProgress':
      return {success: true, data: listVocabularyProgress_(session, input.studentId)};
    case 'saveVocabularyProgress':
      return saveVocabularyProgress_(session, input);
    case 'saveVocabularyTargets':
      return saveVocabularyTargets_(session, input);
    case 'setOwnTargetChanges':
      return setOwnTargetChanges_(session, input);
    case 'setOwnTargetSelection':
      return setOwnTargetSelection_(session, input);
    case 'listHomework':
      const homework = listHomework_(session, input.filters || {});
      return {success: true, homework, groups: groupHomeworkRows_(homework)};
    case 'listOverdueHomeworkStudents':
      return {success: true, ...listOverdueHomeworkStudents_(session)};
    case 'declareHomework':
      return declareHomework_(session, input);
    case 'declareHomeworkGroup':
      return declareHomeworkGroup_(session, input);
    case 'confirmHomework':
      return confirmHomework_(session, input);
    case 'confirmHomeworkGroup':
      return confirmHomeworkGroup_(session, input);
    case 'acknowledgeMilestone':
      return acknowledgeMilestone_(session, input);
    case 'listAchievementHistory':
      return {success: true, achievements: listAchievementHistory_(session, input)};
    case 'getAdminStudentList':
      return {success: true, students: getAdminStudentList_(session, input.filters || {})};
    case 'setStudentTarget':
      return setStudentTarget_(session, input);
    case 'setStandardRange':
      return setStandardRange_(session, input);
    case 'listUnitMaster':
      return {success: true, units: listUnitMaster_(session)};
    case 'syncStudentProfiles':
      return syncStudentProfiles_(session);
    case 'listGradeConflicts':
      return {success: true, conflicts: listGradeConflicts_(session)};
    case 'listAuditLog':
      return {success: true, auditLog: listAuditLog_(session, input.limit)};
    case 'runDevelopmentIntegrationTests':
      requireRole_(session, [ROLE.ADMIN]);
      return runDevelopmentIntegrationTests();
    default:
      throw publicError_('不明な操作です。', 'UNKNOWN_ACTION');
  }
}

function jsonOutput_(value) {
  return ContentService
    .createTextOutput(JSON.stringify(value))
    .setMimeType(ContentService.MimeType.JSON);
}

// ===== SecurityTests.gs =====
function runStudentAuthPerformanceSmokeTest() {
  if (!isDevelopment_()) throw new Error('開発環境以外では実行できません。');
  const testPassword = getRequiredProperty_(PROP.DEV_TEST_STUDENT_PASSWORD);
  const measure = callback => {
    const startedAt = Date.now();
    const result = callback();
    return {elapsedMs: Date.now() - startedAt, success: !!result.success, code: String(result.code || '')};
  };
  clearStudentAuthCache_();
  const errorRowsBefore = getRowsAsObjects_('ErrorLog').length;
  const unknownCold = measure(() => api({action: 'studentLogin', studentId: 'AUTH-PERF-NOT-FOUND', password: 'invalid'}));
  const unknownWarm = measure(() => api({action: 'studentLogin', studentId: 'AUTH-PERF-NOT-FOUND', password: 'invalid'}));
  const wrongPassword = measure(() => api({action: 'studentLogin', studentId: 'TEST-STUDENT-01', password: testPassword + '-wrong'}));
  const correctLogin = measure(() => api({action: 'studentLogin', studentId: 'TEST-STUDENT-01', password: testPassword}));
  const sequential = [];
  for (let i = 0; i < 5; i++) {
    const studentId = i % 2 === 0 ? 'TEST-STUDENT-01' : 'TEST-STUDENT-02';
    sequential.push(measure(() => api({action: 'studentLogin', studentId, password: testPassword})));
  }
  const errorRowsAfter = getRowsAsObjects_('ErrorLog').length;
  const result = {
    success: !unknownCold.success && !unknownWarm.success && !wrongPassword.success && correctLogin.success && sequential.every(item => item.success) && errorRowsAfter === errorRowsBefore,
    unknownCold,
    unknownWarm,
    wrongPassword,
    correctLogin,
    sequential,
    invalidCredentialErrorRowsAdded: errorRowsAfter - errorRowsBefore,
    cacheSeconds: STUDENT_AUTH_CACHE_SECONDS,
    notFoundCacheSeconds: STUDENT_AUTH_NOT_FOUND_SECONDS,
    checkedAt: nowIso_()
  };
  console.log(JSON.stringify(result));
  if (!result.success) throw new Error('認証性能スモークテストに失敗しました。');
  return result;
}

