      progressId: current ? current.progressId : Utilities.getUuid(),
      studentId,
      unitId,
      pointConfirmed: !!learningDate,
      warmupConfirmed: false,
      tryCompleted: false,
      tryResult: '',
      studentUpdatedAt: session.role === ROLE.STUDENT ? now : (current && current.studentUpdatedAt || ''),
      updatedAt: now,
      updatedBy: session.userId,
      lctResult: '',
      lctDate: '',
      learningDate,
      pointCompletedAt: learningDate ? (current && current.pointCompletedAt || now) : '',
      warmupCompletedAt: '',
      tryCompletedAt: '',
      clientRevision: Number(input.clientRevision || 0),
