// ===== Auth.gs =====
function authTrace_(stage, startedAt, detail) {
  const safeDetail = Object.assign({}, detail || {});
  console.info(JSON.stringify(Object.assign({stage, elapsedMs: Date.now() - startedAt}, safeDetail)));
}

function perfTrace_(stage, startedAt, detail) {
  const safeDetail = Object.assign({}, detail || {});
  console.info(JSON.stringify(Object.assign({stage, elapsedMs: Date.now() - startedAt}, safeDetail)));
}

function maskedStudentId_(studentId) {
  const value = String(studentId || '');
  return value.length <= 2 ? '**' : '**' + value.slice(-2);
}

function getStudentAuthCacheVersion_() {
  const cache = CacheService.getScriptCache();
  let version = cache.get(STUDENT_AUTH_CACHE_VERSION_KEY);
  if (!version) {
    version = String(Date.now());
    cache.put(STUDENT_AUTH_CACHE_VERSION_KEY, version, STUDENT_AUTH_CACHE_SECONDS);
  }
  return version;
}

function studentAuthCacheKey_(studentId, version) {
  return ['FS', 'STUDENT_AUTH', isDevelopment_() ? 'DEV' : 'PROD', version || getStudentAuthCacheVersion_(), String(studentId || '')].join(':');
}

function studentAuthNotFoundCacheKey_(studentId, version) {
  return ['FS', 'STUDENT_AUTH_NOT_FOUND', isDevelopment_() ? 'DEV' : 'PROD', version || getStudentAuthCacheVersion_(), String(studentId || '')].join(':');
}

function studentAuthRecordFromRow_(row, rowNumber) {
  const studentId = String(row[0] || '').trim();
  if (!studentId) return null;
  const gradeJRaw = String(row[9] || '').trim();
  const gradeKRaw = String(row[10] || '').trim();
  return {
    rowNumber,
    studentId,
    status: studentStatusFromMaster_(row[1]),
    password: String(row[11] || ''),
    name: String(row[4] || '').trim(),
    campus: String(row[7] || '').trim(),
    gradeJRaw,
    gradeKRaw,
    school: String(row[15] || '').trim()
  };
}

function rebuildStudentAuthCache_() {
  const master = SpreadsheetApp.openById(getRequiredProperty_(PROP.STUDENT_MASTER_SS_ID));
  const sheet = master.getSheetByName(getRequiredProperty_(PROP.STUDENT_MASTER_SHEET_NAME));
  if (!sheet) throw new Error('生徒マスタの正本シートが見つかりません。');
  const rows = sheet.getDataRange().getValues();
  const cache = CacheService.getScriptCache();
  const version = String(Date.now());
  cache.put(STUDENT_AUTH_CACHE_VERSION_KEY, version, STUDENT_AUTH_CACHE_SECONDS);
  const entries = {};
  let cachedCount = 0;
  for (let i = 1; i < rows.length; i++) {
    const record = studentAuthRecordFromRow_(rows[i], i + 1);
    if (!record) continue;
    entries[studentAuthCacheKey_(record.studentId, version)] = JSON.stringify(record);
    cachedCount++;
    if (Object.keys(entries).length >= 80) {
      cache.putAll(entries, STUDENT_AUTH_CACHE_SECONDS);
      Object.keys(entries).forEach(key => delete entries[key]);
    }
  }
  if (Object.keys(entries).length) cache.putAll(entries, STUDENT_AUTH_CACHE_SECONDS);
  return {version, cachedCount};
}

function clearStudentAuthCache_() {
  const version = String(Date.now());
  CacheService.getScriptCache().put(STUDENT_AUTH_CACHE_VERSION_KEY, version, STUDENT_AUTH_CACHE_SECONDS);
  return {version};
}

function rebuildStudentAuthCache() {
  return rebuildStudentAuthCache_();
}

function clearStudentAuthCache() {
  return clearStudentAuthCache_();
}



function getStudentAuthRecord_(studentId) {
  const timing = {cacheReadMs: 0, idSearchMs: 0, studentRowReadMs: 0, cacheWriteMs: 0};
  const cache = CacheService.getScriptCache();
  const version = getStudentAuthCacheVersion_();
  const authKey = studentAuthCacheKey_(studentId, version);
  const notFoundKey = studentAuthNotFoundCacheKey_(studentId, version);
  let stageStartedAt = Date.now();
  const cached = cache.get(authKey);
  timing.cacheReadMs += Date.now() - stageStartedAt;
  if (cached) return {record: JSON.parse(cached), cacheHit: true, timing};
  stageStartedAt = Date.now();
  const notFoundCached = cache.get(notFoundKey);
  timing.cacheReadMs += Date.now() - stageStartedAt;
  if (notFoundCached) return {record: null, cacheHit: true, timing};
  const master = SpreadsheetApp.openById(getRequiredProperty_(PROP.STUDENT_MASTER_SS_ID));
  const sheet = master.getSheetByName(getRequiredProperty_(PROP.STUDENT_MASTER_SHEET_NAME));
  if (!sheet) throw new Error('生徒マスタの正本シートが見つかりません。');
  const lastRow = sheet.getLastRow();
  stageStartedAt = Date.now();
  const match = lastRow > 1 ? sheet.getRange(2, 1, lastRow - 1, 1).createTextFinder(String(studentId)).matchEntireCell(true).findNext() : null;
  timing.idSearchMs = Date.now() - stageStartedAt;
  if (!match) {
    stageStartedAt = Date.now();
    cache.put(notFoundKey, '1', STUDENT_AUTH_NOT_FOUND_SECONDS);
    timing.cacheWriteMs = Date.now() - stageStartedAt;
    return {record: null, cacheHit: false, timing};
  }
  const rowNumber = match.getRow();
  stageStartedAt = Date.now();
  const record = studentAuthRecordFromRow_(sheet.getRange(rowNumber, 1, 1, 16).getValues()[0], rowNumber);
  timing.studentRowReadMs = Date.now() - stageStartedAt;
  stageStartedAt = Date.now();
  cache.put(authKey, JSON.stringify(record), STUDENT_AUTH_CACHE_SECONDS);
  timing.cacheWriteMs = Date.now() - stageStartedAt;
  return {record, cacheHit: false, timing};
}

function authenticateStudent_(studentId, password) {
  const startedAt = Date.now();
  const timing = {inputNormalizeMs: 0, cacheReadMs: 0, idSearchMs: 0, studentRowReadMs: 0, cacheWriteMs: 0, availabilityCheckMs: 0, passwordCheckMs: 0, profileBuildMs: 0};
  let stageStartedAt = Date.now();
  const id = String(studentId || '').trim();
  const pass = String(password || '');
  timing.inputNormalizeMs = Date.now() - stageStartedAt;
  authTrace_('auth.start', startedAt, {student: maskedStudentId_(id)});
  if (!id || !pass) throw publicError_('生徒番号とパスワードを入力してください。', 'LOGIN_REQUIRED');

  const testAuth = authenticateDevelopmentTestStudent_(id, pass);
  if (testAuth) {
    testAuth.authStartedAt = startedAt;
    return testAuth;
  }

  const lookup = getStudentAuthRecord_(id);
  Object.assign(timing, lookup.timing || {});
  authTrace_('auth.studentLookup', startedAt, {student: maskedStudentId_(id), cacheHit: lookup.cacheHit});
  const record = lookup.record;
  if (!record) throw publicError_('生徒番号またはパスワードが違います。', 'INVALID_CREDENTIALS');
  stageStartedAt = Date.now();
  if (record.status !== 'ACTIVE') {
    throw publicError_('退塾・休塾等のためログインできません。教室へお問い合わせください。', 'STUDENT_INACTIVE');
  }
  timing.availabilityCheckMs = Date.now() - stageStartedAt;
  stageStartedAt = Date.now();
  if (!safeStringEquals_(record.password, pass)) {
    authTrace_('auth.passwordCheck', startedAt, {student: maskedStudentId_(id), success: false});
    throw publicError_('生徒番号またはパスワードが違います。', 'INVALID_CREDENTIALS');
  }
  timing.passwordCheckMs = Date.now() - stageStartedAt;
  authTrace_('auth.passwordCheck', startedAt, {student: maskedStudentId_(id), success: true});
  const gradeJ = normalizeGrade_(record.gradeJRaw);
  const gradeK = normalizeGrade_(record.gradeKRaw);
  const grade = gradeJ || gradeK;
  if (!grade) throw publicError_('中学生の学年を確認できません。教室へお問い合わせください。', 'GRADE_NOT_FOUND');
  stageStartedAt = Date.now();
  const result = {
    profile: {
      studentId: id,
      name: record.name,
      campus: record.campus,
      grade,
      gradeJRaw: record.gradeJRaw,
      gradeKRaw: record.gradeKRaw,
      gradeConflict: !!(gradeJ && gradeK && gradeJ !== gradeK),
      school: record.school,
      enrollmentStatus: 'ACTIVE',
      lastSyncedAt: nowIso_()
    },
    permissionLevel: '',
    role: ROLE.STUDENT,
    authStartedAt: startedAt,
    authTiming: timing
  };
  timing.profileBuildMs = Date.now() - stageStartedAt;
  timing.authenticationTotalMs = Date.now() - startedAt;
  return result;
}

function authenticateStaff_(code, password) {
  const loginId = String(code || '').trim();
  const pass = String(password || '');
  if (!loginId || !pass) throw publicError_('講師番号とパスワードを入力してください。', 'LOGIN_REQUIRED');

  const testAuth = authenticateDevelopmentTestStaff_(loginId, pass);
  if (testAuth) return testAuth;

  const book = SpreadsheetApp.openById(getRequiredProperty_(PROP.STAFF_MASTER_SS_ID));
  const sheet = book.getSheetByName(getRequiredProperty_(PROP.STAFF_MASTER_SHEET_NAME));
  if (!sheet) throw new Error('講師マスターが見つかりません。');
  const rows = sheet.getDataRange().getValues();
  for (let i = 1; i < rows.length; i++) {
    if (String(rows[i][0] || '').trim() !== loginId) continue;
    const savedPassword = String(rows[i][35] || '');
    if (!savedPassword || !safeStringEquals_(savedPassword, pass)) {
      throw publicError_('講師番号またはパスワードが違います。', 'INVALID_CREDENTIALS');
    }
    const permissionLevel = String(rows[i][36] || '').trim();
    const role = roleFromPermissionLevel_(permissionLevel);
    if (!role) throw publicError_('このアプリを利用する権限がありません。', 'FORBIDDEN');
    return {
      profile: {
        staffId: loginId,
        name: String(rows[i][1] || '').trim()
      },
      permissionLevel,
      role
    };
  }
  throw publicError_('講師番号またはパスワードが違います。', 'INVALID_CREDENTIALS');
}

function authenticateDevelopmentTestStudent_(id, password) {
  if (!isDevelopment_() || !/^TEST-STUDENT-(0[12]|INACTIVE)$/.test(id)) return null;
  if (!safeStringEquals_(getRequiredProperty_(PROP.DEV_TEST_STUDENT_PASSWORD), password)) {
    throw publicError_('生徒番号またはパスワードが違います。', 'INVALID_CREDENTIALS');
  }
  if (id === 'TEST-STUDENT-INACTIVE') {
    throw publicError_('退塾・休塾等のためログインできません。教室へお問い合わせください。', 'STUDENT_INACTIVE');
  }
  const suffix = id.endsWith('01') ? 'A' : 'B';
  const profile = {
    studentId: id,
    name: 'テスト生徒' + suffix,
    campus: '神領校',
    grade: '中2',
    gradeJRaw: '中2',
    gradeKRaw: '中2',
    gradeConflict: false,
    school: 'テスト中学校',
    enrollmentStatus: 'ACTIVE',
    lastSyncedAt: nowIso_()
  };
  return {profile: profile, permissionLevel: '', role: ROLE.STUDENT};
}

function authenticateDevelopmentTestStaff_(id, password) {
  if (!isDevelopment_() || !/^TEST-(TEACHER|ADMIN)-01$/.test(id)) return null;
  if (!safeStringEquals_(getRequiredProperty_(PROP.DEV_TEST_STAFF_PASSWORD), password)) {
    throw publicError_('講師番号またはパスワードが違います。', 'INVALID_CREDENTIALS');
  }
  const isAdmin = id.indexOf('ADMIN') >= 0;
  return {
    profile: {staffId: id, name: isAdmin ? 'テスト管理者' : 'テスト講師'},
    permissionLevel: isAdmin ? '2' : '1',
    role: isAdmin ? ROLE.ADMIN : ROLE.TEACHER
  };
}

function createSession_(userType, userId, role, permissionLevel) {
  const startedAt = Date.now();
  const timing = {tokenGenerateMs: 0, tokenHashMs: 0, sessionSaveMs: 0, sessionCacheWriteMs: 0};
  let stageStartedAt = Date.now();
  const rawToken = Utilities.getUuid() + '-' + Utilities.getUuid();
  const issuedAt = new Date();
  const expiresAt = new Date(issuedAt.getTime() + SESSION_HOURS * 60 * 60 * 1000);
  timing.tokenGenerateMs = Date.now() - stageStartedAt;
  stageStartedAt = Date.now();
  const tokenHash = hashToken_(rawToken);
  timing.tokenHashMs = Date.now() - stageStartedAt;
  const sessionRow = {
    tokenHash,
    userType,
    userId,
    role,
    permissionLevel: permissionLevel || '',
    issuedAt: issuedAt.toISOString(),
    expiresAt: expiresAt.toISOString(),
    revokedAt: ''
  };
  stageStartedAt = Date.now();
  appendObjectsFast_('Sessions', [sessionRow]);
  timing.sessionSaveMs = Date.now() - stageStartedAt;
  stageStartedAt = Date.now();
  cacheSessionRow_(sessionRow);
  timing.sessionCacheWriteMs = Date.now() - stageStartedAt;
  timing.sessionTotalMs = Date.now() - startedAt;
  perfTrace_('session.create', startedAt, {userType});
  return {token: rawToken, expiresAt: expiresAt.toISOString(), timing};
}

function sessionCacheKey_(tokenHash) {
  return ['FS', 'SESSION', isDevelopment_() ? 'DEV' : 'PROD', String(tokenHash || '')].join(':');
}

function cacheSessionRow_(row) {
  if (!row || !row.tokenHash || row.revokedAt) return;
  const remainingSeconds = Math.floor((new Date(row.expiresAt).getTime() - Date.now()) / 1000);
  if (remainingSeconds <= 0) return;
  CacheService.getScriptCache().put(
    sessionCacheKey_(row.tokenHash),
    JSON.stringify({
      tokenHash: String(row.tokenHash),
      userType: String(row.userType),
      userId: String(row.userId),
      role: String(row.role),
      permissionLevel: String(row.permissionLevel || ''),
      expiresAt: String(row.expiresAt),
      revokedAt: String(row.revokedAt || '')
    }),
    Math.min(remainingSeconds, 21600)
  );
}

function verifySession_(token) {
  const startedAt = Date.now();
  if (!token) throw publicError_('ログインが必要です。', 'UNAUTHENTICATED');
  const hash = hashToken_(String(token));
  const cache = CacheService.getScriptCache();
  const cacheKey = sessionCacheKey_(hash);
  const cached = cache.get(cacheKey);
  let row = cached ? JSON.parse(cached) : null;
  const cacheHit = !!row;
  if (!row) row = getFirstRowByFieldValue_('Sessions', 'tokenHash', hash);
  if (!row || new Date(row.expiresAt).getTime() <= Date.now()) {
    cache.remove(cacheKey);
    throw publicError_('セッションの有効期限が切れました。再度ログインしてください。', 'SESSION_EXPIRED');
  }
  if (row.revokedAt) {
    cache.remove(cacheKey);
    throw publicError_('セッションの有効期限が切れました。再度ログインしてください。', 'SESSION_EXPIRED');
  }
  if (!cacheHit) cacheSessionRow_(row);
  perfTrace_('session.verify', startedAt, {cacheHit});
  return {
    userType: String(row.userType),
    userId: String(row.userId),
    role: String(row.role),
    permissionLevel: String(row.permissionLevel || '')
  };
}

function logout_(token) {
  const hash = hashToken_(String(token || ''));
  const row = getFirstRowByFieldValue_('Sessions', 'tokenHash', hash);
  if (row) updateObjectRow_('Sessions', row._rowNumber, {revokedAt: nowIso_()});
  CacheService.getScriptCache().remove(sessionCacheKey_(hash));
  return {success: true};
}

function hashToken_(token) {
  const bytes = Utilities.computeHmacSha256Signature(
    token,
    getRequiredProperty_(PROP.SESSION_SECRET),
    Utilities.Charset.UTF_8
  );
  return bytes.map(byte => ('0' + ((byte + 256) % 256).toString(16)).slice(-2)).join('');
}

function safeStringEquals_(expected, actual) {
  const a = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, expected, Utilities.Charset.UTF_8);
  const b = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, actual, Utilities.Charset.UTF_8);
  let different = a.length ^ b.length;
  const length = Math.max(a.length, b.length);
  for (let i = 0; i < length; i++) different |= (a[i % a.length] ^ b[i % b.length]);
  return different === 0;
}

function upsertStudentProfile_(profile) {
  const sheet = getSheet_('StudentProfiles');
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map(String);
  const studentIdColumn = headers.indexOf('studentId') + 1;
  if (!studentIdColumn) throw new Error('StudentProfiles.studentId列が見つかりません。');
  const lastRow = sheet.getLastRow();
  const match = lastRow > 1 ? sheet.getRange(2, studentIdColumn, lastRow - 1, 1).createTextFinder(String(profile.studentId)).matchEntireCell(true).findNext() : null;
  if (!match) {
    sheet.appendRow(headers.map(header => profile[header] == null ? '' : profile[header]));
    cacheStudentProfile_(profile);
    return;
  }
  const rowNumber = match.getRow();
  const current = sheet.getRange(rowNumber, 1, 1, headers.length).getValues()[0];
  const changed = headers.some((header, index) => Object.prototype.hasOwnProperty.call(profile, header) && String(current[index] == null ? '' : current[index]) !== String(profile[header] == null ? '' : profile[header]));
  if (changed) {
    const next = headers.map((header, index) => Object.prototype.hasOwnProperty.call(profile, header) ? profile[header] : current[index]);
    sheet.getRange(rowNumber, 1, 1, next.length).setValues([next]);
  }
  cacheStudentProfile_(profile);
}

function getCachedStudentProfile_(studentId) {
  const id = String(studentId || '');
  const cache = CacheService.getScriptCache();
  const key = ['FS', 'PROFILE', isDevelopment_() ? 'DEV' : 'PROD', id].join(':');
  const cached = cache.get(key);
  if (cached) return JSON.parse(cached);
  const row = getFirstRowByFieldValue_('StudentProfiles', 'studentId', id);
  if (!row) return null;
  const profile = Object.assign({}, row);
  delete profile._rowNumber;
  cache.put(key, JSON.stringify(profile), 300);
  return profile;
}

function cacheStudentProfile_(profile) {
  if (!profile || !profile.studentId) return;
  const copy = Object.assign({}, profile);
  delete copy._rowNumber;
  const key = [
    'FS',
    'PROFILE',
    isDevelopment_() ? 'DEV' : 'PROD',
    String(profile.studentId)
  ].join(':');
  CacheService.getScriptCache().put(key, JSON.stringify(copy), 300);
}

// ===== Setup.gs =====
function initializeDevelopmentEnvironment() {
  if (!isDevelopment_()) throw new Error('開発環境以外では実行できません。');
  [
    PROP.PROGRESS_DB_SS_ID,
    PROP.STUDENT_MASTER_SS_ID,
    PROP.STUDENT_MASTER_SHEET_NAME,
    PROP.STAFF_MASTER_SS_ID,
    PROP.STAFF_MASTER_SHEET_NAME,
    PROP.SESSION_SECRET,
    PROP.DEV_TEST_STUDENT_PASSWORD,
    PROP.DEV_TEST_STAFF_PASSWORD
  ].forEach(getRequiredProperty_);
  const result = setupDatabase();
  seedDevelopmentProfiles_();
  return Object.assign({}, result, validateUnitMaster_());
}

function ensureDevelopmentInitialized_() {
  if (!isDevelopment_()) return;
  const db = getDb_();
  const unitSheet = db.getSheetByName(SHEET_NAMES.Units);
  const rangeSheet = db.getSheetByName(SHEET_NAMES.StandardRanges);
  const profileSheet = db.getSheetByName(SHEET_NAMES.StudentProfiles);
  const expectedStandardRows = UNIT_MASTER_SEED
    .filter(unit => unit.standardEligible)
    .reduce((count, unit) => count + (unit.gradeScope === '中1～中3共通' ? 3 : 1), 0);
  if (
    !unitSheet || unitSheet.getLastRow() !== UNIT_MASTER_SEED.length + 1 ||
    !rangeSheet || rangeSheet.getLastRow() !== expectedStandardRows + 1 ||
    !profileSheet || profileSheet.getLastRow() <= 1
  ) {
    initializeDevelopmentEnvironment();
  }
}

function seedDevelopmentProfiles_() {
  if (!isDevelopment_()) throw new Error('開発環境以外では実行できません。');
  ['TEST-STUDENT-01','TEST-STUDENT-02'].forEach((studentId, index) => {
    upsertStudentProfile_({
      studentId,
      name: 'テスト生徒' + (index === 0 ? 'A' : 'B'),
      campus: '神領校',
      grade: '中2',
      gradeJRaw: '中2',
      gradeKRaw: '中2',
      gradeConflict: false,
      school: 'テスト中学校',
      enrollmentStatus: 'ACTIVE',
      lastSyncedAt: nowIso_()
    });
  });
}

function validateUnitMaster_() {
  const rows = getRowsAsObjects_('Units');
  const ids = rows.map(row => String(row.unitId));
  const summaryCount = rows.filter(row => String(row.unitType) === 'SUMMARY').length;
  const standardIds = new Set(
    getRowsAsObjects_('StandardRanges')
      .filter(row => String(row.included).toLowerCase() !== 'false')
      .map(row => String(row.unitId))
  );
  const invalidPreSteps = rows.filter(row =>
    String(row.unitType) === 'PRE_STEP' && standardIds.has(String(row.unitId))
  ).length;
  return {
    totalUnits: rows.length,
    uniqueUnits: new Set(ids).size,
    summaryCount,
    preStepCount: rows.filter(row => String(row.unitType) === 'PRE_STEP').length,
    normalCount: rows.filter(row => String(row.unitType) === 'NORMAL').length,
    summaryInStandard: rows.filter(row =>
      String(row.unitType) === 'SUMMARY' && standardIds.has(String(row.unitId))
    ).length,
    preStepInStandard: invalidPreSteps
  };
}

// ===== ProgressService.gs =====
function getStudentTargetUnitIds_(studentId, subject, series) {
  const profile = getCachedStudentProfile_(studentId);
  if (!profile) return [];
  return getStudentTargetUnitIdsForProfile_(
    String(studentId),
    profile,
    subject,
    series,
    getRowsByFieldValue_('StudentTargets', 'studentId', studentId)
  );
}

function getStudentTargetUnitIdsForProfile_(studentId, profile, subject, series, targetRows) {
  const overrides = targetRows
    .filter(row =>
      String(row.studentId) === String(studentId) &&
      (!subject || row.subject === subject) &&
      (!series || normalizeSeries_(row.series) === normalizeSeries_(series))
    );
  const overrideMap = new Map(overrides.map(row => [String(row.unitId), String(row.included).toLowerCase() !== 'false']));
  const target = new Set(getCachedStandardUnitIds_(profile.grade, subject, series));
  overrideMap.forEach((included, unitId) => included ? target.add(unitId) : target.delete(unitId));
  return Array.from(target);
}

function getStudentDashboard_(session, requestedStudentId) {
  const startedAt = Date.now();
  const studentId = resolveStudentId_(session, requestedStudentId, [ROLE.TEACHER, ROLE.ADMIN]);
  const profile = getCachedStudentProfile_(studentId);
  if (!profile) throw new Error('生徒情報が見つかりません。');
  const studentTargets = getRowsByFieldValue_('StudentTargets', 'studentId', studentId);
  const targets = getStudentTargetUnitIdsForProfile_(studentId, profile, '', '', studentTargets);
  const targetSet = new Set(targets);
  const studentProgress = getRowsByFieldValue_('UnitProgress', 'studentId', studentId)
    .filter(row => rowSchoolYear_(row) === SCHOOL_YEAR);
  const progress = studentProgress.filter(row => targetSet.has(String(row.unitId)));
  const selectableUnits = filterUnitsForProfile_(profile, getCachedSelectableUnits_(profile.grade));
  const units = selectableUnits.filter(row => targetSet.has(String(row.unitId)));
  const selectableById = new Map(selectableUnits.map(unit => [String(unit.unitId), unit]));
  const progressMap = new Map(progress.map(row => [
    progressRoundKey_(row.unitId, rowRoundNumber_(row)), row
  ]));
  const subjects = ['英語','数学','国語','理科','社会'].map(subject => {
    const ids = units.filter(unit => unit.subject === subject).map(unit => String(unit.unitId));
    const rounds = STUDY_ROUNDS.map(roundNumber => {
      const done = ids.filter(id => {
        const row = progressMap.get(progressRoundKey_(id, roundNumber));
        return row && isTrue_(row.tryCompleted);
      }).length;
      return {roundNumber, targetCount: ids.length, completedCount: done, progressRate: ids.length ? done / ids.length : null};
    });
    const done = rounds.reduce((sum, round) => sum + round.completedCount, 0);
    return {subject, targetCount: ids.length, completedCount: done, progressRate: ids.length ? done / ids.length : null, rounds};
  });
  const homework = filterHomeworkByLessonProgress_(
    getRowsByFieldValue_('Homework', 'studentId', studentId),
    studentProgress
  );
  const today = todayInJapan_();
  const todayProgress = studentProgress.filter(row =>
    dateOnly_(row.learningDate) === today
  );
  const todayHomework = homework.filter(row =>
    dateOnly_(row.assignedDate || row.createdAt) === today
  );
  const lctTargetIds = new Set(units.filter(unitHasLct_).map(unit => String(unit.unitId)));
  const lctCompletedCount = progress.filter(row =>
    lctTargetIds.has(String(row.unitId)) && !!String(row.lctResult || '')
  ).length;
  let reachedMilestones = [];
  let milestoneRows = [];
  try {
    milestoneRows = getRowsByFieldValue_('Milestones', 'studentId', studentId);
    reachedMilestones = milestoneRows
      .filter(row => !row.scopeType || String(row.scopeType) === 'OVERALL')
      .map(row => Number(row.percent));
  } catch (ignored) {
    reachedMilestones = [];
  }
  const roundProgress = STUDY_ROUNDS.map(roundNumber => {
    const completedCount = targets.filter(unitId => {
      const row = progressMap.get(progressRoundKey_(unitId, roundNumber));
      return row && isTrue_(row.tryCompleted);
    }).length;
    return {
      roundNumber,
      targetCount: targets.length,
      completedCount,
      progressRate: targets.length ? completedCount / targets.length : null
    };
  });
  const completedCount = roundProgress.reduce((sum, round) => sum + round.completedCount, 0);
  const percent = targets.length ? Math.round(completedCount / targets.length * 100) : 0;
  const newMilestone = [300,250,200,150,125,100,75,50,25]
    .find(value => percent >= value && !reachedMilestones.includes(value)) || null;
  const mapUnit = unit => {
    const rounds = STUDY_ROUNDS.map(roundNumber => {
      const state = progressMap.get(progressRoundKey_(unit.unitId, roundNumber)) ||
        studentProgress.find(row =>
          String(row.unitId) === String(unit.unitId) && rowRoundNumber_(row) === roundNumber
        ) || {};
      return progressStateForClient_(state, roundNumber);
    });
    return {
      unitId: unit.unitId,
      subject: unit.subject,
      stepCode: unit.stepCode,
      unitTitle: unit.unitTitle,
      unitType: unit.unitType,
      series: normalizeSeries_(unit.series),
      seriesLabel: seriesLabel_(unit.series),
      hasLct: unitHasLct_(unit),
      homeworkItems: homeworkTypesForUnit_(unit),
      ...rounds[0],
      rounds,
      chapterKey: unit.chapterId || 'other',
      chapterLabel: unit.chapterLabel || '章未設定'
    };
  };
  const outsideProgressIds = new Set(studentProgress
    .filter(row => !targetSet.has(String(row.unitId)))
    .map(row => String(row.unitId)));
  const dashboard = {
    profile,
    overall: {
      targetCount: targets.length,
      completedCount,
      progressRate: targets.length ? completedCount / targets.length : null,
      rounds: roundProgress
    },
    subjects,
    lct: {
      completedCount: lctCompletedCount,
      targetCount: lctTargetIds.size,
      progressRate: lctTargetIds.size ? lctCompletedCount / lctTargetIds.size : null
    },
    homeworkSummary: {
      totalCount: homework.length,
      verifiedCount: homework.filter(row => row.teacherStatus === 'VERIFIED' || row.teacherStatus === 'NOT_APPLICABLE').length,
      notDoneCount: homework.filter(row => row.teacherStatus === 'NOT_DONE').length,
      unconfirmedCount: homework.filter(row => row.teacherStatus === 'UNCONFIRMED').length
    },
    today: {
      learnedUnitCount: new Set(todayProgress.map(row => progressRoundKey_(row.unitId, rowRoundNumber_(row)))).size,
      tryCompletedCount: todayProgress.filter(row => dateOnly_(row.tryCompletedAt) === today).length,
      homeworkUnitCount: new Set(todayHomework
        .map(row => progressRoundKey_(row.unitId, rowRoundNumber_(row)))).size,
      homeworkItemCount: todayHomework.length,
      materials: [MATERIAL_SERIES.STEP, MATERIAL_SERIES.GOAL, MATERIAL_SERIES.REQUIRED_TEXTBOOK].flatMap(series =>
        ['英語','数学','国語','理科','社会'].map(subject => ({
          series,
          seriesLabel: seriesLabel_(series),
          subject,
          unitCount: new Set(todayProgress.filter(row => {
            const unit = selectableById.get(String(row.unitId));
            return unit &&
              normalizeSeries_(unit.series) === series &&
              unit.subject === subject;
          }).map(row => progressRoundKey_(row.unitId, rowRoundNumber_(row)))).size
        }))
      ).filter(row => row.unitCount > 0),
      subjects: ['英語','数学','国語','理科','社会'].map(subject => ({
        subject,
        unitCount: new Set(todayProgress.filter(row => {
          const unit = selectableById.get(String(row.unitId));
          return unit && unit.subject === subject;
        }).map(row => progressRoundKey_(row.unitId, rowRoundNumber_(row)))).size
      })).filter(row => row.unitCount > 0)
    },
    newMilestone,
    units: units.map(mapUnit),
    outsideTargetUnits: selectableUnits.filter(unit =>
      outsideProgressIds.has(String(unit.unitId))
    ).map(mapUnit),
    selectableUnits: selectableUnits.map(unit => ({
      unitId: unit.unitId,
      subject: unit.subject,
      series: normalizeSeries_(unit.series),
      seriesLabel: seriesLabel_(unit.series),
      stepCode: unit.stepCode,
      unitTitle: unit.unitTitle,
      unitType: unit.unitType,
      hasLct: unitHasLct_(unit),
      homeworkItems: homeworkTypesForUnit_(unit),
      displayOrder: unit.displayOrder,
      chapterKey: unit.chapterId,
      chapterLabel: unit.chapterLabel,
      targetIncluded: targetSet.has(String(unit.unitId))
    })),
    lastStudentInputAt: studentProgress.map(row => row.studentUpdatedAt).filter(Boolean).sort().pop() || ''
  };
  dashboard.achievements = achievementState_(studentId, percent, subjects, milestoneRows);
  perfTrace_('dashboard.complete', startedAt, {
    student: maskedStudentId_(studentId),
    progressRows: studentProgress.length,
    homeworkRows: homework.length,
    targetRows: studentTargets.length
  });
  return dashboard;
}

function saveStudentProgressBatch_(session, input) {
  requireRole_(session, [ROLE.STUDENT, ROLE.ADMIN]);
  const changes = Array.isArray(input.changes) ? input.changes.slice(0, 50) : [];
  if (!changes.length) throw publicError_('保存する変更がありません。', 'PROGRESS_CHANGES_REQUIRED');
  const seen = new Set();
  const deduped = changes.filter(change => {
    const key = String(change.unitId || '') + ':' + normalizeRoundNumber_(change.roundNumber);
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
  const startedAt = Date.now();
  requestFilteredRowsCache_ = new Map();
  const results = deduped.map(change => {
    try {
      return saveStudentProgress_(session, change);
    } catch (error) {
      return {success:false,unitId:String(change.unitId||''),roundNumber:Number(change.roundNumber||1),clientRevision:Number(change.clientRevision||0),clientMutationId:String(change.clientMutationId||''),error:error&&error.message?error.message:'保存に失敗しました。'};
    }
  });
  const response = {success:true,requestedCount:changes.length,savedCount:results.filter(result=>result.success).length,failedCount:results.filter(result=>!result.success).length,elapsedMs:Date.now()-startedAt,results};
  requestFilteredRowsCache_ = null;
  return response;
}

function saveStudentProgress_(session, input) {
  requireRole_(session, [ROLE.STUDENT, ROLE.ADMIN]);
  const studentId = resolveStudentId_(session, input.studentId, [ROLE.ADMIN]);
  const unitId = String(input.unitId || '');
  const roundNumber = normalizeRoundNumber_(input.roundNumber);
  const profile = getCachedStudentProfile_(studentId);
  if (!profile) throw new Error('生徒情報が見つかりません。');
  const selectableUnits = filterUnitsForProfile_(profile, getCachedSelectableUnits_(profile.grade));
  const selectableIds = new Set(selectableUnits.map(unit => String(unit.unitId)));
  if (!selectableIds.has(unitId)) throw publicError_('選択できない単元です。', 'INVALID_PROGRESS_UNIT');
  const selectedUnit = selectableUnits.find(unit => String(unit.unitId) === unitId);
  const targetRows = getRowsByFieldValue_('StudentTargets', 'studentId', studentId);
  const targetIds = getStudentTargetUnitIdsForProfile_(studentId, profile, '', '', targetRows);
  const lctResult = unitHasLct_(selectedUnit) ? String(input.lctResult || '') : '';
  if (!['', 'PERFECT', 'PASS', 'REVIEW'].includes(lctResult)) {
    throw publicError_('LCTは◎・○・×から選択してください。', 'INVALID_LCT_RESULT');
  }

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const rows = getRowsByFieldValue_('UnitProgress', 'studentId', studentId);
    const current = rows.find(row =>
      String(row.studentId) === studentId &&
      String(row.unitId) === unitId &&
      rowSchoolYear_(row) === SCHOOL_YEAR &&
      rowRoundNumber_(row) === roundNumber
    );
    const before = current ? {...current} : null;
    const now = nowIso_();
    const today = todayInJapan_();
    const pointConfirmed = !!input.pointConfirmed;
    const warmupConfirmed = !!input.warmupConfirmed;
    const tryCompleted = !!input.tryCompleted;
    const studied = pointConfirmed || warmupConfirmed || tryCompleted;
    const newlyStudied =
      (pointConfirmed && !isTrue_(current && current.pointConfirmed)) ||
      (warmupConfirmed && !isTrue_(current && current.warmupConfirmed)) ||
      (tryCompleted && !isTrue_(current && current.tryCompleted));
    const previousLearningDate = dateOnly_(current && current.learningDate) ||
      dateOnly_(current && current.studentUpdatedAt);
    const lctChanged = String(current && current.lctResult || '') !== lctResult;
    const next = {
      progressId: current ? current.progressId : Utilities.getUuid(),
      studentId,
      unitId,
      pointConfirmed,
      warmupConfirmed,
      tryCompleted,
      tryResult: '',
      studentUpdatedAt: session.role === ROLE.STUDENT ? now : (current && current.studentUpdatedAt || ''),
      updatedAt: now,
      updatedBy: session.userId,
      lctResult,
      lctDate: lctResult ? (lctChanged ? now : (current && current.lctDate || now)) : '',
      learningDate: newlyStudied ? today : (studied ? previousLearningDate : ''),
      pointCompletedAt: pointConfirmed
        ? (isTrue_(current && current.pointConfirmed) ? current.pointCompletedAt : now)
        : '',
      warmupCompletedAt: warmupConfirmed
        ? (isTrue_(current && current.warmupConfirmed) ? current.warmupCompletedAt : now)
        : '',
      tryCompletedAt: tryCompleted
        ? (isTrue_(current && current.tryCompleted) ? current.tryCompletedAt : now)
        : '',
      clientRevision: Number(input.clientRevision || 0),
      clientMutationId: String(input.clientMutationId || '').slice(0, 80),
      schoolYear: SCHOOL_YEAR,
      roundNumber,
      series: normalizeSeries_(selectedUnit.series)
    };
    if (current) updateObjectRowFast_('UnitProgress', current, next);
    else appendObjectsFast_('UnitProgress', [next]);
    const createdHomework = hasLessonProgress_(next)
      ? ensureHomeworkForLessonProgress_(studentId, unitId, roundNumber, SCHOOL_YEAR, today, true)
      : [];
    appendAuditFast_(session, current ? 'UPDATE_PROGRESS' : 'CREATE_PROGRESS', 'UnitProgress', next.progressId, before, next);

    const updatedRows = rows.filter(row =>
      String(row.studentId) === studentId && rowSchoolYear_(row) === SCHOOL_YEAR
    );
    const currentIndex = updatedRows.findIndex(row =>
      String(row.unitId) === unitId && rowRoundNumber_(row) === roundNumber
    );
    if (currentIndex >= 0) updatedRows[currentIndex] = Object.assign({}, current, next);
    else updatedRows.push(next);
    const targetSet = new Set(targetIds);
    const completedKeys = new Set(updatedRows.filter(row =>
      targetSet.has(String(row.unitId)) && isTrue_(row.tryCompleted)
    ).map(row => progressRoundKey_(row.unitId, rowRoundNumber_(row))));
    const unitSubjectById = getCachedUnitSubjectMap_();
    const subjectAggregates = ['英語','数学','国語','理科','社会'].map(subject => {
      const ids = targetIds.filter(id => unitSubjectById[id] === subject);
      const rounds = STUDY_ROUNDS.map(value => {
        const done = ids.filter(id => completedKeys.has(progressRoundKey_(id, value))).length;
        return {roundNumber: value, targetCount: ids.length, completedCount: done, progressRate: ids.length ? done / ids.length : null};
      });
      const done = rounds.reduce((sum, item) => sum + item.completedCount, 0);
      return {subject, targetCount: ids.length, completedCount: done, progressRate: ids.length ? done / ids.length : null, rounds};
    });
    const rounds = STUDY_ROUNDS.map(value => {
      const done = targetIds.filter(id => completedKeys.has(progressRoundKey_(id, value))).length;
      return {roundNumber: value, targetCount: targetIds.length, completedCount: done, progressRate: targetIds.length ? done / targetIds.length : null};
    });
    const completedCount = rounds.reduce((sum, item) => sum + item.completedCount, 0);
    return {
      success: true,
      clientRevision: next.clientRevision,
      clientMutationId: next.clientMutationId,
      progress: next,
      createdHomework,
      aggregates: {
        overall: {
          targetCount: targetIds.length,
          completedCount,
          progressRate: targetIds.length ? completedCount / targetIds.length : null,
          rounds
        },
        subjects: subjectAggregates
      }
    };
  } finally {
    lock.releaseLock();
  }
}

function listVocabularyProgress_(session, requestedStudentId) {
  const studentId = resolveStudentId_(session, requestedStudentId, [ROLE.TEACHER, ROLE.ADMIN]);
  const rows = getRowsByFieldValue_('UnitProgress', 'studentId', studentId)
    .filter(row =>
      rowSchoolYear_(row) === SCHOOL_YEAR &&
      normalizeSeries_(row.series) === MATERIAL_SERIES.VOCABULARY &&
      VOCABULARY_LEVELS.includes(vocabularyLevelFromUnitId_(row.unitId))
    );
  const byKey = new Map(rows.map(row => {
    const direction = vocabularyDirectionFromUnitId_(row.unitId, rowRoundNumber_(row));
    return [vocabularyLevelFromUnitId_(row.unitId) + ':' + direction + ':' + rowRoundNumber_(row), row];
  }));
  const targetRows = getRowsByFieldValue_('StudentTargets', 'studentId', studentId)
    .filter(row =>
      String(row.subject) === '英語' &&
      normalizeSeries_(row.series) === MATERIAL_SERIES.VOCABULARY
    );
  const targetMap = new Map(targetRows.map(row => [
    String(row.unitId), String(row.included).toLowerCase() !== 'false'
  ]));
  return {
    studentId,
    levels: VOCABULARY_LEVELS.map((level, displayOrder) => ({
      level,
      displayOrder,
      directions: ['英→日','日→英'].map(direction => ({
        direction,
        unitId: vocabularyUnitId_(level, direction),
        targetIncluded: targetMap.get(vocabularyUnitId_(level, direction)) === true,
        rounds: STUDY_ROUNDS.map(roundNumber => {
          const row = byKey.get(level + ':' + direction + ':' + roundNumber) || {};
          return {
            roundNumber,
            learningDate: dateOnly_(row.learningDate),
            updatedAt: row.updatedAt || ''
          };
        })
      }))
    }))
  };
}

