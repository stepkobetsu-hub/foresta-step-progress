      schoolYear: row.schoolYear || SCHOOL_YEAR,
      scopeType: row.scopeType || 'OVERALL',
      subject: row.subject || '',
      percent: Number(row.percent || 0),
      reachedAt: row.reachedAt || '',
      characterId: row.characterId || '',
      rarity: row.rarity || 'COMMON',
      messageId: row.messageId || ''
    }));
}

function setOwnTargetSelection_(session, input) {
  requireRole_(session, [ROLE.STUDENT]);
  const studentId = resolveStudentId_(session, input.studentId, [ROLE.ADMIN]);
  const subject = String(input.subject || '');
  const series = normalizeSeries_(input.series);
  if (!['英語','数学','国語','理科','社会'].includes(subject)) {
    throw publicError_('科目を選択してください。', 'SUBJECT_REQUIRED');
  }
  const profile = getCachedStudentProfile_(studentId);
  if (!profile) throw new Error('生徒情報が見つかりません。');
  const candidates = getSelectableUnitsForProfile_(profile, getRowsAsObjects_('Units'))
    .filter(unit =>
      String(unit.subject) === subject &&
      normalizeSeries_(unit.series) === series
    );
  const candidateIds = new Set(candidates.map(unit => String(unit.unitId)));
  const selectedIds = new Set((input.unitIds || []).map(String));
  if (Array.from(selectedIds).some(unitId => !candidateIds.has(unitId))) {
    throw publicError_('選択できない単元が含まれています。', 'INVALID_TARGET_UNIT');
  }
  const previousTargetCount = getStudentTargetUnitIds_(studentId, subject, series).length;

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const currentRows = getRowsAsObjects_('StudentTargets');
    const currentByUnit = new Map(currentRows
      .filter(row =>
        String(row.studentId) === studentId &&
        String(row.subject) === subject &&
        normalizeSeries_(row.series) === series
      )
      .map(row => [String(row.unitId), row]));
    const now = nowIso_();
    const replacementRows = candidates.map(unit => {
      const unitId = String(unit.unitId);
      const current = currentByUnit.get(unitId);
      return {
        studentTargetId: current ? current.studentTargetId : Utilities.getUuid(),
        studentId,
        masterVersion: MASTER_VERSION,
        subject,
        unitId,
        included: selectedIds.has(unitId),
        source: 'STUDENT_SELECTION',
        createdAt: current ? current.createdAt : now,
        updatedAt: now,
        updatedBy: studentId,
        series
      };
    });
    replaceStudentTargetSubjectRows_(studentId, subject, series, currentRows, replacementRows);
    writeAudit_(
      session,
      'SET_OWN_TARGET_SELECTION',
      'StudentTargets',
      studentId + ':' + subject + ':' + series,
      {subject, series, previousTargetCount},
      {
        subject,
        series,
        selectedCount: selectedIds.size,
        unselectedCount: candidates.length - selectedIds.size,
        selectionHash: digestSelection_(Array.from(selectedIds))
      }
    );
  } finally {
    lock.releaseLock();
  }
  return {success: true, subject, targetCount: selectedIds.size};
}

function setStudentTarget_(session, input) {
  requireRole_(session, [ROLE.ADMIN]);
  const studentId = String(input.studentId || '');
  const unitId = String(input.unitId || '');
  const included = !!input.included;
  const rows = getRowsAsObjects_('StudentTargets');
  const current = rows.find(row => String(row.studentId) === studentId && String(row.unitId) === unitId);
  const unit = getRowsAsObjects_('Units').find(row => String(row.unitId) === unitId);
  if (!unit) throw new Error('単元が見つかりません。');
  const now = nowIso_();
  const next = {
    studentTargetId: current ? current.studentTargetId : Utilities.getUuid(),
    studentId,
    masterVersion: MASTER_VERSION,
    subject: unit.subject,
    unitId,
    included,
    source: 'ADMIN_OVERRIDE',
    createdAt: current ? current.createdAt : now,
    updatedAt: now,
    updatedBy: session.userId,
    series: normalizeSeries_(unit.series)
  };
  if (current) updateObjectRow_('StudentTargets', current._rowNumber, next);
  else appendObject_('StudentTargets', next);
  writeAudit_(session, 'SET_STUDENT_TARGET', 'StudentTargets', next.studentTargetId, current, next);
  return {success: true};
}

function getStudentInputHistory_(session, requestedStudentId, limit) {
  const studentId = resolveStudentId_(session, requestedStudentId, [ROLE.TEACHER, ROLE.ADMIN]);
  const max = Math.min(Math.max(Number(limit || 50), 1), 200);
  return getRowsAsObjects_('AuditLog')
    .filter(row =>
      String(row.actorType) === 'STUDENT' &&
      String(row.actorId) === studentId &&
      ['CREATE_PROGRESS','UPDATE_PROGRESS','DECLARE_HOMEWORK'].includes(String(row.action))
    )
    .slice(-max)
    .reverse()
    .map(row => ({
      action: row.action,
      entityType: row.entityType,
      entityId: row.entityId,
      createdAt: row.createdAt
    }));
}

function isTrue_(value) {
  return value === true || String(value).toLowerCase() === 'true' || String(value) === '1';
}

function getSelectableUnitsForProfile_(profile, units) {
  return filterUnitsForProfile_(profile, units)
    .filter(unit => isTrue_(unit.active))
    .filter(unit =>
      String(unit.gradeScope) === String(profile.grade) ||
      String(unit.gradeScope) === '中1～中3共通' ||
      (
        isDevelopment_() &&
        normalizeSeries_(unit.series) === MATERIAL_SERIES.GOAL &&
        String(unit.gradeScope) === '中3'
      )
    )
    .sort((a, b) => Number(a.displayOrder || 0) - Number(b.displayOrder || 0));
}

function dateOnly_(value) {
  if (!value) return '';
  if (value instanceof Date) return Utilities.formatDate(value, 'Asia/Tokyo', 'yyyy-MM-dd');
  return String(value).slice(0, 10);
}

function todayInJapan_() {
  return Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
}

function progressRoundKey_(unitId, roundNumber) {
  return String(unitId) + ':' + String(normalizeRoundNumber_(roundNumber));
}

function progressStateForClient_(state, roundNumber) {
  return {
    roundNumber,
    lctResult: state.lctResult || '',
    lctRecordedAt: state.lctDate || '',
    pointConfirmed: isTrue_(state.pointConfirmed),
    warmupConfirmed: isTrue_(state.warmupConfirmed),
    tryCompleted: isTrue_(state.tryCompleted),
    learningDate: dateOnly_(state.learningDate),
    pointCompletedAt: state.pointCompletedAt || '',
    warmupCompletedAt: state.warmupCompletedAt || '',
    tryCompletedAt: state.tryCompletedAt || ''
  };
}

function replaceStudentTargetSubjectRows_(studentId, subject, series, currentRows, replacementRows) {
  const sheet = getSheet_('StudentTargets');
  const headers = DB_SCHEMAS.StudentTargets;
  const untouched = currentRows.filter(row =>
    !(
      String(row.studentId) === studentId &&
      String(row.subject) === subject &&
      normalizeSeries_(row.series) === normalizeSeries_(series)
    )
  );
  const finalRows = untouched.concat(replacementRows);
  const writeRowCount = Math.max(currentRows.length, finalRows.length);
  if (!writeRowCount) return;
  const values = Array.from({length: writeRowCount}, (_, index) => {
    const row = finalRows[index];
    return headers.map(header => row && row[header] != null ? row[header] : '');
  });
  sheet.getRange(2, 1, writeRowCount, headers.length).setValues(values);
}

function digestSelection_(unitIds) {
  const bytes = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    unitIds.slice().sort().join('|'),
    Utilities.Charset.UTF_8
  );
  return bytes.map(byte => ('0' + (byte & 0xff).toString(16)).slice(-2)).join('');
}

// ===== HomeworkService.gs =====
function ensureHomeworkForLessonProgress_(studentId, unitId, roundNumber, schoolYear, assignedDate, lockAlreadyHeld) {
  if (lockAlreadyHeld) {
    return ensureHomeworkForLessonProgressUnlocked_(studentId, unitId, roundNumber, schoolYear, assignedDate);
  }
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    return ensureHomeworkForLessonProgressUnlocked_(studentId, unitId, roundNumber, schoolYear, assignedDate);
  } finally {
    lock.releaseLock();
  }
}

function ensureHomeworkForLessonProgressUnlocked_(studentId, unitId, roundNumber, schoolYear, assignedDate) {
  const rows = getRowsByFieldValue_('Homework', 'studentId', studentId);
  const unit = getCachedUnitMap_()[String(unitId)];
  if (!unit) throw publicError_('単元が見つかりません。', 'UNIT_NOT_FOUND');
  const now = nowIso_();
  const round = normalizeRoundNumber_(roundNumber);
  const year = Number(schoolYear || SCHOOL_YEAR);
  const assignmentDate = dateOnly_(assignedDate) || todayInJapan_();
  const additions = homeworkTypesForUnit_(unit)
    .map(homeworkType => ({homeworkType, studentStatus: 'UNINPUT'}))
    .filter(seed => !rows.some(row =>
      String(row.studentId) === studentId &&
      String(row.unitId) === unitId &&
      rowSchoolYear_(row) === year &&
      rowRoundNumber_(row) === round &&
      dateOnly_(row.assignedDate || row.createdAt) === assignmentDate &&
      String(row.homeworkType) === seed.homeworkType
    )).map(seed => ({
      homeworkId: Utilities.getUuid(),
      studentId,
      unitId,
      homeworkType: seed.homeworkType,
      studentStatus: seed.studentStatus,
      teacherStatus: 'UNCONFIRMED',
      studentUpdatedAt: '',
      teacherUpdatedAt: '',
      confirmedBy: '',
      confirmationMemo: '',
      createdAt: now,
      updatedAt: now,
      schoolYear: year,
      roundNumber: round,
      assignedDate: assignmentDate,
      studentCompletedAt: '',
      studentCompletedDate: '',
      studentNoTargetAt: '',
      studentNoTargetDate: '',
      series: normalizeSeries_(unit.series)
    }));
  appendObjectsFast_('Homework', additions);
  return additions;
}

function ensureVocabularyHomeworkUnlocked_(studentId, level, direction, roundNumber, schoolYear, assignedDate) {
  const unitId = vocabularyUnitId_(level, direction);
  const round = normalizeRoundNumber_(roundNumber);
  const year = Number(schoolYear || SCHOOL_YEAR);
  const assignmentDate = dateOnly_(assignedDate) || todayInJapan_();
  const rows = getRowsByFieldValue_('Homework', 'studentId', studentId);
  const exists = rows.some(row =>
    String(row.unitId) === unitId &&
    rowSchoolYear_(row) === year &&
    rowRoundNumber_(row) === round &&
    dateOnly_(row.assignedDate || row.createdAt) === assignmentDate &&
    String(row.homeworkType) === HOMEWORK_TYPES.VOCABULARY_REVIEW
  );
  if (exists) return [];
  const now = nowIso_();
  const addition = {
    homeworkId: Utilities.getUuid(),
    studentId,
    unitId,
    homeworkType: HOMEWORK_TYPES.VOCABULARY_REVIEW,
    studentStatus: 'UNINPUT',
    teacherStatus: 'UNCONFIRMED',
    studentUpdatedAt: '',
    teacherUpdatedAt: '',
    confirmedBy: '',
    confirmationMemo: '',
    createdAt: now,
    updatedAt: now,
    schoolYear: year,
    roundNumber: round,
    assignedDate: assignmentDate,
    studentCompletedAt: '',
    studentCompletedDate: '',
    studentNoTargetAt: '',
    studentNoTargetDate: '',
    series: MATERIAL_SERIES.VOCABULARY,
    dueDate: ''
  };
  appendObjectsFast_('Homework', [addition]);
  return [addition];
}

function validateHomeworkGroup_(rows, session, input, allowedRoles) {
  requireRole_(session, allowedRoles);
  const ids = new Set((input.homeworkIds || []).map(String));
  const selected = rows.filter(row => ids.has(String(row.homeworkId)));
  if (!selected.length || selected.length !== ids.size) {
    throw publicError_('宿題が見つかりません。', 'HOMEWORK_NOT_FOUND');
  }
  const identity = row => [
    String(row.studentId),
    String(row.unitId),
    String(rowSchoolYear_(row)),
    String(rowRoundNumber_(row)),
    dateOnly_(row.assignedDate || row.createdAt)
  ].join('|');
  if (new Set(selected.map(identity)).size !== 1) {
    throw publicError_('別の生徒・単元・日付の宿題を同時には更新できません。', 'MIXED_HOMEWORK_GROUP');
  }
  if (session.role === ROLE.STUDENT && selected.some(row => String(row.studentId) !== session.userId)) {
    throw publicError_('他の生徒の宿題は更新できません。', 'FORBIDDEN_STUDENT_SCOPE');
  }
  return selected;
}

function declareHomeworkGroup_(session, input) {
  const rows = getRowsAsObjects_('Homework');
  const selected = validateHomeworkGroup_(rows, session, input, [ROLE.STUDENT]);
  const selectedIds = new Set(selected.map(row => String(row.homeworkId)));
  const now = nowIso_();
  const updatedIds = [];
  const finalRows = rows.map(row => {
    if (!selectedIds.has(String(row.homeworkId))) return row;
    if (row.homeworkType === 'TRY_REDO' &&
        (row.studentStatus === 'NO_TARGET_CLAIM' || row.teacherStatus === 'NOT_APPLICABLE')) {
      return row;
    }
    updatedIds.push(String(row.homeworkId));
    return Object.assign({}, row, {
      studentStatus: 'DECLARED_DONE',
      studentUpdatedAt: now,
      updatedAt: now,
      studentCompletedAt: now,
      studentCompletedDate: todayInJapan_()
    });
  });
  replaceAllObjectRowsFast_('Homework', finalRows, rows.length);
  appendAuditFast_(session, 'DECLARE_HOMEWORK_GROUP', 'Homework', updatedIds.join(','), null, {updatedIds});
  return {success: true, updatedIds};
}

function confirmHomeworkGroup_(session, input) {
  const rows = getRowsAsObjects_('Homework');
  const selected = validateHomeworkGroup_(rows, session, input, [ROLE.TEACHER, ROLE.ADMIN]);
  const selectedIds = new Set(selected.map(row => String(row.homeworkId)));
  const now = nowIso_();
  const updatedIds = [];
  const finalRows = rows.map(row => {
    if (!selectedIds.has(String(row.homeworkId))) return row;
    const notApplicable = row.homeworkType === 'TRY_REDO' &&
      (row.teacherStatus === 'NOT_APPLICABLE' || row.studentStatus === 'NO_TARGET_CLAIM');
    updatedIds.push(String(row.homeworkId));
    return Object.assign({}, row, {
      teacherStatus: notApplicable ? 'NOT_APPLICABLE' : 'VERIFIED',
      teacherUpdatedAt: now,
      confirmedBy: session.userId,
      confirmationMemo: String(input.confirmationMemo || '').slice(0, 200),
      updatedAt: now
    });
  });
  replaceAllObjectRowsFast_('Homework', finalRows, rows.length);
  appendAuditFast_(session, 'CONFIRM_HOMEWORK_GROUP', 'Homework', updatedIds.join(','), null, {updatedIds});
  return {success: true, updatedIds};
}

function declareHomework_(session, input) {
  requireRole_(session, [ROLE.STUDENT]);
  const row = getRowsAsObjects_('Homework').find(item =>
    String(item.homeworkId) === String(input.homeworkId) &&
    String(item.studentId) === session.userId
  );
  if (!row) throw new Error('宿題が見つかりません。');
  const allowed = row.homeworkType === 'TRY_REDO'
    ? ['DECLARED_DONE','NO_TARGET_CLAIM','UNINPUT']
    : ['DECLARED_DONE','UNINPUT'];
  if (!allowed.includes(input.studentStatus)) throw new Error('選択できない状態です。');
  if (row.teacherStatus !== 'UNCONFIRMED' && input.studentStatus !== row.studentStatus) {
    throw publicError_('先生の確認済みのため変更できません。', 'HOMEWORK_ALREADY_CONFIRMED');
  }
  const before = {...row};
  const now = nowIso_();
  const today = todayInJapan_();
  const next = {
    studentStatus: input.studentStatus,
    studentUpdatedAt: now,
    updatedAt: now,
    studentCompletedAt: input.studentStatus === 'DECLARED_DONE' ? now : '',
    studentCompletedDate: input.studentStatus === 'DECLARED_DONE' ? today : '',
    studentNoTargetAt: input.studentStatus === 'NO_TARGET_CLAIM' ? now : '',
    studentNoTargetDate: input.studentStatus === 'NO_TARGET_CLAIM' ? today : ''
  };
  updateObjectRowFast_('Homework', row, next);
  appendAuditFast_(session, 'DECLARE_HOMEWORK', 'Homework', row.homeworkId, before, {...row, ...next});
  return {success: true, homework: Object.assign({}, row, next)};
}

function confirmHomework_(session, input) {
  requireRole_(session, [ROLE.TEACHER, ROLE.ADMIN]);
  const row = getRowsAsObjects_('Homework').find(item => String(item.homeworkId) === String(input.homeworkId));
  if (!row) throw new Error('宿題が見つかりません。');
  const allowed = row.homeworkType === 'TRY_REDO'
    ? ['VERIFIED','NOT_DONE','NOT_APPLICABLE','UNCONFIRMED']
    : ['VERIFIED','NOT_DONE','UNCONFIRMED'];
  if (!allowed.includes(input.teacherStatus)) throw new Error('選択できない状態です。');
  const before = {...row};
  const next = {
    teacherStatus: input.teacherStatus,
    teacherUpdatedAt: nowIso_(),
    confirmedBy: session.userId,
    confirmationMemo: String(input.confirmationMemo || '').slice(0, 200),
    updatedAt: nowIso_()
  };
  if (input.teacherStatus === 'UNCONFIRMED' && row.homeworkType === 'TRY_REDO' &&
      row.studentStatus === 'NO_TARGET_CLAIM') {
    next.studentStatus = 'UNINPUT';
    next.studentNoTargetAt = '';
    next.studentNoTargetDate = '';
  }
  updateObjectRowFast_('Homework', row, next);
  appendAuditFast_(session, 'CONFIRM_HOMEWORK', 'Homework', row.homeworkId, before, {...row, ...next});
  return {success: true, homework: Object.assign({}, row, next)};
}

function homeworkDueDate_(row) {
  // assignedDate（宿題日）は期限日ではない。明示された期限日だけを使用する。
  return dateOnly_(row && (row.dueDate || row.deadlineDate || row.homeworkDueDate));
}

function dateDayNumber_(value) {
  const match = String(value || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!match) return null;
  return Math.floor(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])) / 86400000);
}

function dateFromDayNumber_(dayNumber) {
  if (!Number.isFinite(dayNumber)) return '';
  return Utilities.formatDate(new Date(dayNumber * 86400000), 'UTC', 'yyyy-MM-dd');
}

function homeworkOverdueDate_(row) {
  const dueDay = dateDayNumber_(homeworkDueDate_(row));
  return dueDay == null
    ? ''
    : dateFromDayNumber_(dueDay + HOMEWORK_OVERDUE_RULE.showFromDaysAfterDueDate);
}

function isOverdueHomework_(row, today) {
  const overdueDay = dateDayNumber_(homeworkOverdueDate_(row));
  const todayDay = dateDayNumber_(today);
  if (overdueDay == null || todayDay == null) return false;
  if (String(row.studentStatus) !== 'UNINPUT') return false;
  if (['VERIFIED', 'NOT_APPLICABLE'].includes(String(row.teacherStatus))) return false;
  if (isTrue_(row.cancelled) || isTrue_(row.invalid) || isTrue_(row.hidden)) return false;
  return todayDay >= overdueDay;
}

function hasLessonProgress_(record) {
  return !!record && (
    isTrue_(record.pointConfirmed) ||
    isTrue_(record.warmupConfirmed) ||
    isTrue_(record.tryCompleted)
  );
}

function lessonProgressKey_(row) {
  return [
    String(row.studentId), String(row.unitId),
    String(rowSchoolYear_(row)), String(rowRoundNumber_(row))
  ].join(':');
}

function filterHomeworkByLessonProgress_(homeworkRows, progressRows) {
  const progressedKeys = new Set((progressRows || [])
    .filter(hasLessonProgress_)
    .map(lessonProgressKey_));
  return (homeworkRows || []).filter(row => progressedKeys.has(lessonProgressKey_(row)));
}

function enrichHomeworkRows_(rows, knownProgressRows) {
  const unitById = getCachedUnitMap_();
  const studentIds = Array.from(new Set((rows || []).map(row => String(row.studentId))));
  const progressRows = knownProgressRows || (
    studentIds.length === 1
      ? getRowsByFieldValue_('UnitProgress', 'studentId', studentIds[0])
      : getRowsAsObjects_('UnitProgress')
  );
  const visibleRows = filterHomeworkByLessonProgress_(rows, progressRows);
  const progressByStudentUnit = new Map(progressRows.map(row => [
    [String(row.studentId), String(row.unitId), String(rowSchoolYear_(row)), String(rowRoundNumber_(row))].join(':'),
    row
  ]));
  return visibleRows.map(row => {
    const unit = unitById[String(row.unitId)] || {};
    const vocabularyLevel = vocabularyLevelFromUnitId_(row.unitId);
    const vocabulary = !!vocabularyLevel;
    const progressKey = [
      String(row.studentId), String(row.unitId), String(rowSchoolYear_(row)), String(rowRoundNumber_(row))
    ].join(':');
    const progress = progressByStudentUnit.get(progressKey) || {};
    const roundNumber = rowRoundNumber_(row);
    return {
      ...row,
      subject: vocabulary ? '英語' : (unit.subject || ''),
      series: normalizeSeries_(row.series || unit.series),
      seriesLabel: seriesLabel_(row.series || unit.series),
      stepCode: vocabulary ? vocabularyLevel : (unit.stepCode || ''),
      unitTitle: vocabulary
        ? roundNumber + '周目（' + vocabularyDirectionFromUnitId_(row.unitId, roundNumber) + '）'
        : (unit.unitTitle || ''),
      homeworkLabel: vocabulary
        ? vocabularyLevel + ' ' + roundNumber + '周目（' + vocabularyDirectionFromUnitId_(row.unitId, roundNumber) + '）の赤×なおしや見直し'
        : (HOMEWORK_LABELS[String(row.homeworkType)] || String(row.homeworkType || '')),
      learningDate: dateOnly_(progress.learningDate),
      schoolYear: rowSchoolYear_(row),
      roundNumber,
      assignedDate: dateOnly_(row.assignedDate || row.createdAt),
      dueDate: homeworkDueDate_(row),
      overdueDate: homeworkOverdueDate_(row),
      studentCompletedDate: dateOnly_(row.studentCompletedDate || row.studentCompletedAt),
      studentNoTargetDate: dateOnly_(row.studentNoTargetDate || row.studentNoTargetAt)
    };
  });
}

function listHomework_(session, filters) {
  const startedAt = Date.now();
  let rows;
  let visible;
  if (session.role === ROLE.STUDENT) {
    const studentId = resolveStudentId_(session, filters && filters.studentId, [ROLE.TEACHER, ROLE.ADMIN]);
    rows = getRowsByFieldValue_('Homework', 'studentId', studentId);
    visible = rows;
  } else {
    requireRole_(session, [ROLE.TEACHER, ROLE.ADMIN]);
    if (filters && filters.studentId) {
      rows = getRowsByFieldValue_('Homework', 'studentId', String(filters.studentId));
    } else {
      rows = getRowsAsObjects_('Homework');
    }
    visible = rows;
  }
  const result = enrichHomeworkRows_(visible).filter(row => {
    if (filters && filters.studentStatus && row.studentStatus !== filters.studentStatus) return false;
    if (filters && filters.teacherStatus && row.teacherStatus !== filters.teacherStatus) return false;
    if (filters && filters.overdueOnly && !isOverdueHomework_(row, todayInJapan_())) return false;
    return true;
  }).sort((a, b) => String(b.createdAt || '').localeCompare(String(a.createdAt || '')));
  perfTrace_('homework.complete', startedAt, {role: session.role, rows: result.length});
  return result;
}

function listOverdueHomeworkStudents_(session) {
  requireRole_(session, [ROLE.TEACHER, ROLE.ADMIN]);
  const today = todayInJapan_();
  const profiles = new Map(getRowsAsObjects_('StudentProfiles').map(row => [String(row.studentId), row]));
  const overdueRows = enrichHomeworkRows_(getRowsAsObjects_('Homework'))
    .filter(row => isOverdueHomework_(row, today));
  const byStudent = new Map();
  overdueRows.forEach(row => {
    const studentId = String(row.studentId);
    const profile = profiles.get(studentId) || {};
    if (!byStudent.has(studentId)) {
      byStudent.set(studentId, {
        studentId,
        studentName: String(profile.name || studentId),
        grade: String(profile.grade || ''),
        overdueCount: 0,
        oldestDueDate: row.dueDate,
        newestOverdueDate: row.overdueDate,
        subjects: [],
        materials: []
      });
    }
    const summary = byStudent.get(studentId);
    summary.overdueCount++;
    if (row.dueDate < summary.oldestDueDate) summary.oldestDueDate = row.dueDate;
    if (row.overdueDate > summary.newestOverdueDate) summary.newestOverdueDate = row.overdueDate;
    if (row.subject && !summary.subjects.includes(row.subject)) summary.subjects.push(row.subject);
    if (row.seriesLabel && !summary.materials.includes(row.seriesLabel)) summary.materials.push(row.seriesLabel);
  });
  const students = Array.from(byStudent.values()).sort((a, b) =>
    String(b.newestOverdueDate).localeCompare(String(a.newestOverdueDate)) ||
    String(a.studentName).localeCompare(String(b.studentName), 'ja') ||
    String(a.studentId).localeCompare(String(b.studentId))
  );
  return {
    students,
    totalStudents: students.length,
    today,
    rule: {
      showFromDaysAfterDueDate: HOMEWORK_OVERDUE_RULE.showFromDaysAfterDueDate,
      timezone: 'Asia/Tokyo'
    }
  };
}

function groupHomeworkRows_(rows) {
  const groups = [];
  const byKey = new Map();
  rows.forEach(row => {
    const key = [
      String(row.studentId), String(row.unitId), String(row.schoolYear || SCHOOL_YEAR),
      String(row.roundNumber || 1), String(row.assignedDate || dateOnly_(row.createdAt))
    ].join('|');
    if (!byKey.has(key)) {
      const group = {
        groupKey: key,
        studentId: row.studentId,
        unitId: row.unitId,
        schoolYear: row.schoolYear || SCHOOL_YEAR,
        roundNumber: row.roundNumber || 1,
        subject: row.subject,
        series: row.series,
        seriesLabel: row.seriesLabel,
        stepCode: row.stepCode,
        unitTitle: row.unitTitle,
        learningDate: row.learningDate,
        assignedDate: row.assignedDate || dateOnly_(row.createdAt),
        items: []
      };
      byKey.set(key, group);
      groups.push(group);
    }
    byKey.get(key).items.push(row);
  });
  return groups;
}

// ===== AdminService.gs =====
function syncStudentProfiles_(session) {
  requireRole_(session, [ROLE.ADMIN]);
  const master = SpreadsheetApp.openById(getRequiredProperty_(PROP.STUDENT_MASTER_SS_ID));
  const sheet = master.getSheetByName(getRequiredProperty_(PROP.STUDENT_MASTER_SHEET_NAME));
  if (!sheet) throw new Error('生徒マスタが見つかりません。');
  const rows = sheet.getDataRange().getValues();
  let synced = 0;
  let conflicts = 0;
  for (let i = 1; i < rows.length; i++) {
    const studentId = String(rows[i][0] || '').trim();
    if (!studentId) continue;
    const gradeJRaw = String(rows[i][9] || '').trim();
    const gradeKRaw = String(rows[i][10] || '').trim();
    const gradeJ = normalizeGrade_(gradeJRaw);
    const gradeK = normalizeGrade_(gradeKRaw);
    const gradeConflict = !!(gradeJ && gradeK && gradeJ !== gradeK);
    if (gradeConflict) {
      conflicts++;
      upsertGradeConflict_({
        studentId,
        name: String(rows[i][4] || '').trim(),
        campus: String(rows[i][7] || '').trim(),
        gradeJRaw,
        gradeKRaw,
        displayGrade: gradeJ,
        detectedAt: nowIso_()
      });
    }
    upsertStudentProfile_({
      studentId,
      name: String(rows[i][4] || '').trim(),
      campus: String(rows[i][7] || '').trim(),
      grade: gradeJ || gradeK,
      gradeJRaw,
      gradeKRaw,
      gradeConflict,
      school: String(rows[i][15] || '').trim(),
      enrollmentStatus: studentStatusFromMaster_(rows[i][1]),
      lastSyncedAt: nowIso_()
    });
    synced++;
  }
  writeAudit_(session, 'SYNC_STUDENT_PROFILES', 'StudentProfiles', 'BULK', null, {synced, conflicts});
  return {success: true, synced, conflicts};
}

function getAdminStudentList_(session, filters) {
  requireRole_(session, [ROLE.TEACHER, ROLE.ADMIN]);
  const profiles = getRowsAsObjects_('StudentProfiles');
  const progress = getRowsAsObjects_('UnitProgress');
  const homework = filterHomeworkByLessonProgress_(
    getRowsAsObjects_('Homework'),
    progress
  );
  const studentTargets = getRowsAsObjects_('StudentTargets');
  const unitSubjectById = getCachedUnitSubjectMap_();
  const progressByStudent = indexRowsBy_(progress, 'studentId');
  const homeworkByStudent = indexRowsBy_(homework, 'studentId');
  const targetsByStudent = indexRowsBy_(studentTargets, 'studentId');
  const standardByGrade = new Map(['中1','中2','中3'].map(grade => [
    grade,
    new Set(getCachedStandardUnitIds_(grade, ''))
  ]));
  const showActive = !filters || filters.showActive !== false;
  const showInactive = session.role === ROLE.ADMIN && !!(filters && filters.showInactive);

  return profiles.filter(profile => {
    const active = profile.enrollmentStatus === 'ACTIVE';
    if (active && !showActive) return false;
    if (!active && !showInactive) return false;
    if (filters && filters.campus && profile.campus !== filters.campus) return false;
    if (filters && filters.grade && profile.grade !== filters.grade) return false;
    if (filters && filters.name && !String(profile.name).includes(filters.name)) return false;
    return true;
  }).map(profile => {
    const studentId = String(profile.studentId);
    const targetSet = new Set(standardByGrade.get(String(profile.grade)) || []);
    (targetsByStudent.get(studentId) || []).forEach(row => {
        const included = String(row.included).toLowerCase() !== 'false';
        if (included) targetSet.add(String(row.unitId));
        else targetSet.delete(String(row.unitId));
      });
    const targetIds = Array.from(targetSet);
    const studentProgress = progressByStudent.get(studentId) || [];
    const doneSet = new Set(studentProgress.filter(row =>
      rowSchoolYear_(row) === SCHOOL_YEAR &&
      targetSet.has(String(row.unitId)) &&
      isTrue_(row.tryCompleted)
    ).map(row => progressRoundKey_(row.unitId, rowRoundNumber_(row))));
    const roundRates = {};
    STUDY_ROUNDS.forEach(roundNumber => {
      const done = targetIds.filter(id => doneSet.has(progressRoundKey_(id, roundNumber))).length;
      roundRates[roundNumber] = targetIds.length ? done / targetIds.length : null;
    });
    const rates = {};
    ['英語','数学','国語','理科','社会'].forEach(subject => {
      const ids = targetIds.filter(unitId => unitSubjectById[unitId] === subject);
      const completed = STUDY_ROUNDS.reduce((sum, roundNumber) =>
        sum + ids.filter(id => doneSet.has(progressRoundKey_(id, roundNumber))).length, 0);
      rates[subject] = ids.length ? completed / ids.length : null;
    });
    const studentHomework = homeworkByStudent.get(studentId) || [];
    const lastInput = studentProgress
      .map(row => row.studentUpdatedAt).filter(Boolean).sort().pop() || '';
    return {
      ...profile,
      overallRate: targetIds.length ? doneSet.size / targetIds.length : null,
      targetCount: targetIds.length,
      completedCount: doneSet.size,
      subjectRates: rates,
      roundRates,
      unconfirmedHomeworkCount: studentHomework.filter(row =>
        ['DECLARED_DONE','NO_TARGET_CLAIM'].includes(row.studentStatus) &&
        row.teacherStatus === 'UNCONFIRMED'
      ).length,
      notDoneHomeworkCount: studentHomework.filter(row => row.teacherStatus === 'NOT_DONE').length,
      lastStudentInputAt: lastInput
    };
  }).filter(row => {
    if (filters && filters.homeworkStatus === 'UNCONFIRMED' && !row.unconfirmedHomeworkCount) return false;
    if (filters && filters.homeworkStatus === 'NOT_DONE' && !row.notDoneHomeworkCount) return false;
    if (filters && filters.progressStatus === 'NOT_STARTED' && row.overallRate !== 0) return false;
    if (filters && filters.progressStatus === 'IN_PROGRESS' && !(row.overallRate > 0 && row.overallRate < 1)) return false;
    if (filters && filters.progressStatus === 'COMPLETED' && row.overallRate < 1) return false;
    return true;
  });
}

function indexRowsBy_(rows, field) {
  const index = new Map();
  rows.forEach(row => {
    const key = String(row[field]);
    if (!index.has(key)) index.set(key, []);
    index.get(key).push(row);
  });
  return index;
}

function getCachedUnitSubjectMap_() {
  const cache = CacheService.getScriptCache();
  const key = ['FS','UNIT_SUBJECTS',isDevelopment_()?'DEV':'PROD',MASTER_VERSION].join(':');
  const cached = cache.get(key);
  if (cached) return JSON.parse(cached);
  const result = {};
  getRowsAsObjects_('Units').forEach(row => result[String(row.unitId)] = String(row.subject));
  cache.put(key, JSON.stringify(result), 21600);
  return result;
}

function listAuditLog_(session, limit) {
  requireRole_(session, [ROLE.ADMIN]);
  const rows = getRowsAsObjects_('AuditLog');
  return rows.slice(-Math.min(Number(limit || 100), 500)).reverse();
