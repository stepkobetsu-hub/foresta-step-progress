      success: true,
      progress: {
        level,
        roundNumber,
        direction,
        learningDate,
        updatedAt: now
      },
      createdHomework
    };
  } finally {
    lock.releaseLock();
  }
}

function saveVocabularyTargets_(session, input) {
  requireRole_(session, [ROLE.STUDENT, ROLE.ADMIN]);
  const studentId = resolveStudentId_(session, input.studentId, [ROLE.ADMIN]);
  if (!getCachedStudentProfile_(studentId)) throw new Error('生徒情報が見つかりません。');
  const changes = new Map();
  (input.changes || []).forEach(change => {
    const level = String(change.level || '').trim();
    const direction = normalizeVocabularyDirection_(change.direction);
    if (!VOCABULARY_LEVELS.includes(level) || !direction) {
      throw publicError_('選択できない英単語範囲が含まれています。', 'INVALID_VOCABULARY_TARGET');
    }
    changes.set(vocabularyUnitId_(level, direction), {
      level,
      direction,
      selected: !!change.selected
    });
  });
  if (!changes.size) throw publicError_('変更する範囲を選択してください。', 'TARGET_CHANGES_REQUIRED');
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const rows = getRowsAsObjects_('StudentTargets');
    const now = nowIso_();
    const currentByUnit = new Map(rows.filter(row =>
      String(row.studentId) === studentId &&
      String(row.subject) === '英語' &&
      normalizeSeries_(row.series) === MATERIAL_SERIES.VOCABULARY
    ).map(row => [String(row.unitId), row]));
    const replacements = new Map();
    changes.forEach((change, unitId) => {
      const current = currentByUnit.get(unitId);
      replacements.set(unitId, {
        studentTargetId: current ? current.studentTargetId : Utilities.getUuid(),
        studentId,
        masterVersion: MASTER_VERSION,
        subject: '英語',
        unitId,
        included: change.selected,
        source: 'STUDENT_SELECTION',
        createdAt: current ? current.createdAt : now,
        updatedAt: now,
        updatedBy: session.userId,
        series: MATERIAL_SERIES.VOCABULARY
      });
    });
    const finalRows = rows.map(row => {
      if (
        String(row.studentId) !== studentId ||
        String(row.subject) !== '英語' ||
        normalizeSeries_(row.series) !== MATERIAL_SERIES.VOCABULARY
      ) return row;
      return replacements.get(String(row.unitId)) || row;
    });
    replacements.forEach((row, unitId) => {
      if (!currentByUnit.has(unitId)) finalRows.push(row);
    });
    replaceAllObjectRowsFast_('StudentTargets', finalRows, rows.length);
    const targetCount = finalRows.filter(row =>
      String(row.studentId) === studentId &&
      String(row.subject) === '英語' &&
      normalizeSeries_(row.series) === MATERIAL_SERIES.VOCABULARY &&
      String(row.included).toLowerCase() !== 'false'
    ).length;
    appendAuditFast_(session, 'SET_VOCABULARY_TARGETS', 'StudentTargets', studentId, null, {
      changedCount: changes.size,
      targetCount
    });
    return {success: true, changedCount: changes.size, targetCount};
  } finally {
    lock.releaseLock();
  }
}

function setOwnTargetChanges_(session, input) {
  requireRole_(session, [ROLE.STUDENT]);
  const studentId = resolveStudentId_(session, input.studentId, [ROLE.ADMIN]);
  const subject = String(input.subject || '');
  const series = normalizeSeries_(input.series);
  if (!['英語','数学','国語','理科','社会'].includes(subject)) {
    throw publicError_('科目を選択してください。', 'SUBJECT_REQUIRED');
  }
  const profile = getCachedStudentProfile_(studentId);
  if (!profile) throw new Error('生徒情報が見つかりません。');
  const candidates = filterUnitsForProfile_(
    profile,
    getCachedSelectableUnits_(profile.grade, subject, series)
  );
  const candidateIds = new Set(candidates.map(unit => String(unit.unitId)));
  const deduped = new Map();
  (input.changes || []).forEach(change => deduped.set(String(change.unitId || ''), !!change.selected));
  if (!deduped.size || Array.from(deduped.keys()).some(unitId => !candidateIds.has(unitId))) {
    throw publicError_('選択できない単元が含まれています。', 'INVALID_TARGET_UNIT');
  }

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const rows = getRowsAsObjects_('StudentTargets');
    const now = nowIso_();
    const rowByUnit = new Map(rows
      .filter(row =>
        String(row.studentId) === studentId &&
        String(row.subject) === subject &&
        normalizeSeries_(row.series) === series
      )
      .map(row => [String(row.unitId), row]));
    const replacements = new Map();
    deduped.forEach((selected, unitId) => {
      const current = rowByUnit.get(unitId);
      replacements.set(unitId, {
        studentTargetId: current ? current.studentTargetId : Utilities.getUuid(),
        studentId,
        masterVersion: MASTER_VERSION,
        subject,
        unitId,
        included: selected,
        source: 'STUDENT_SELECTION',
        createdAt: current ? current.createdAt : now,
        updatedAt: now,
        updatedBy: studentId,
        series
      });
    });
    const finalRows = rows.map(row => {
      if (
        String(row.studentId) !== studentId ||
        String(row.subject) !== subject ||
        normalizeSeries_(row.series) !== series
      ) return row;
      return replacements.get(String(row.unitId)) || row;
    });
    replacements.forEach((row, unitId) => {
      if (!rowByUnit.has(unitId)) finalRows.push(row);
    });
    replaceAllObjectRowsFast_('StudentTargets', finalRows, rows.length);
    const targetCount = getStudentTargetUnitIdsForProfile_(studentId, profile, subject, series, finalRows).length;
    appendAuditFast_(
      session,
      'SET_OWN_TARGET_CHANGES',
      'StudentTargets',
      studentId + ':' + subject + ':' + series,
      null,
      {subject, series, changedCount: deduped.size, targetCount}
    );
    return {
      success: true,
      subject,
      series,
      changedCount: deduped.size,
      targetCount,
      clientRevision: Number(input.clientRevision || 0)
    };
  } finally {
    lock.releaseLock();
  }
}

const ACHIEVEMENT_PERCENTS_ = Object.freeze([25,50,75,80,100,150,200,250,300]);
const ACHIEVEMENT_CHARACTERS_ = Object.freeze({
  COMMON: ['flag_bear','book_cat','pencil_rabbit'],
  UNCOMMON: ['star_bird','cheer_dog'],
  RARE: ['glasses_owl'],
  ULTRA_RARE: ['crown_friend']
});

function achievementHash_(value) {
  const text = String(value || '');
  let hash = 2166136261;
  for (let index = 0; index < text.length; index += 1) {
    hash ^= text.charCodeAt(index);
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

function achievementSelection_(studentId, scopeType, subject, percent) {
  const key = [studentId, SCHOOL_YEAR, scopeType, subject || '', percent].join(':');
  const hash = achievementHash_(key);
  const roll = hash % 100;
  const rarity = roll < 60 ? 'COMMON' : roll < 90 ? 'UNCOMMON' : roll < 99 ? 'RARE' : 'ULTRA_RARE';
  const candidates = ACHIEVEMENT_CHARACTERS_[rarity];
  return {
    characterId: candidates[Math.floor(hash / 100) % candidates.length],
    rarity,
    messageId: 'MSG_' + (Math.floor(hash / 1000) % 3 + 1)
  };
}

function achievementKey_(row) {
  return [
    String(row.studentId || ''),
    String(row.schoolYear || SCHOOL_YEAR),
    String(row.scopeType || 'OVERALL'),
    String(row.subject || ''),
    Number(row.percent || row.milestonePercent || 0)
  ].join(':');
}

function achievementState_(studentId, overallPercent, subjects, knownRows) {
  let rows = [];
  try {
    rows = (knownRows || getRowsByFieldValue_('Milestones', 'studentId', studentId)).filter(row =>
      String(row.studentId) === studentId &&
      String(row.schoolYear || SCHOOL_YEAR) === String(SCHOOL_YEAR)
    );
  } catch (ignored) {
    rows = [];
  }
  const reached = new Set(rows.map(achievementKey_));
  const candidates = [{scopeType: 'OVERALL', subject: '', rate: overallPercent}]
    .concat((subjects || []).map(item => ({
      scopeType: 'SUBJECT',
      subject: item.subject,
      rate: Math.round(Number(item.progressRate || 0) * 100)
    })));
  const pending = [];
  candidates.forEach(item => {
    ACHIEVEMENT_PERCENTS_.forEach(percent => {
      if (item.rate < percent) return;
      const key = [studentId, SCHOOL_YEAR, item.scopeType, item.subject, percent].join(':');
      if (reached.has(key)) return;
      pending.push(Object.assign({
        schoolYear: SCHOOL_YEAR,
        scopeType: item.scopeType,
        subject: item.subject,
        percent
      }, achievementSelection_(studentId, item.scopeType, item.subject, percent)));
    });
  });
  pending.sort((a, b) =>
    (a.scopeType === 'OVERALL' ? -1 : 1) - (b.scopeType === 'OVERALL' ? -1 : 1) ||
    b.percent - a.percent
  );
  const recent = rows.slice().sort((a, b) => String(b.reachedAt).localeCompare(String(a.reachedAt))).slice(0, 5)
    .map(row => ({
      scopeType: row.scopeType || 'OVERALL',
      subject: row.subject || '',
      percent: Number(row.percent || 0),
      characterId: row.characterId || '',
      rarity: row.rarity || 'COMMON',
      reachedAt: row.reachedAt || ''
    }));
  return {pending, recent};
}

function acknowledgeMilestone_(session, input) {
  requireRole_(session, [ROLE.STUDENT]);
  const studentId = resolveStudentId_(session, input.studentId, [ROLE.ADMIN]);
  const percent = Number(input.percent);
  const scopeType = String(input.scopeType || 'OVERALL');
  const subject = scopeType === 'SUBJECT' ? String(input.subject || '') : '';
  if (!ACHIEVEMENT_PERCENTS_.includes(percent)) throw publicError_('節目が正しくありません。', 'INVALID_MILESTONE');
  if (!['OVERALL','SUBJECT'].includes(scopeType)) throw publicError_('達成対象が正しくありません。', 'INVALID_SCOPE');
  if (scopeType === 'SUBJECT' && !['英語','数学','国語','理科','社会'].includes(subject)) {
    throw publicError_('科目が正しくありません。', 'INVALID_SUBJECT');
  }
  const rows = getRowsAsObjects_('Milestones');
  const selection = achievementSelection_(studentId, scopeType, subject, percent);
  const unique = [studentId, SCHOOL_YEAR, scopeType, subject, percent].join(':');
  let row = rows.find(item => achievementKey_(item) === unique);
  if (!row) {
    row = {
      milestoneId: Utilities.getUuid(),
      studentId,
      schoolYear: SCHOOL_YEAR,
      scopeType,
      subject,
      percent,
      reachedAt: nowIso_(),
      characterId: selection.characterId,
      rarity: selection.rarity,
      messageId: selection.messageId,
      shownAt: nowIso_(),
      acknowledgedAt: nowIso_()
    };
    appendObjectsFast_('Milestones', [row]);
    writeAudit_(session, 'ACHIEVEMENT_REACHED', 'Milestones', row.milestoneId, null, row);
  } else {
    updateObjectRow_('Milestones', row._rowNumber, {shownAt: row.shownAt || nowIso_(), acknowledgedAt: nowIso_()});
  }
  return {success: true, achievement:Object.assign({}, selection, {scopeType, subject, percent})};
}

function listAchievementHistory_(session, input) {
