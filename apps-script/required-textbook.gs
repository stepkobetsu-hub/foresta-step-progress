function seedRequiredTextbookUnits_() {
  const sheet = getSheet_('Units');
  const existingIds = new Set(getRowsAsObjects_('Units').map(row => String(row.unitId)));
  const now = nowIso_();
  const headers = DB_SCHEMAS.Units;
  const additions = REQUIRED_TEXTBOOK_UNIT_SEED
    .filter(unit => !existingIds.has(String(unit.unitId)))
    .map(unit => headers.map(header => {
      if (header === 'createdAt' || header === 'updatedAt') return now;
      return unit[header] == null ? '' : unit[header];
    }));
  if (additions.length) {
    sheet.getRange(sheet.getLastRow() + 1, 1, additions.length, headers.length).setValues(additions);
  }
  invalidateStaticDataCache_();
  return {inserted: additions.length, total: REQUIRED_TEXTBOOK_UNIT_SEED.length};
}

function seedRequiredTextbookUnits() {
  return seedRequiredTextbookUnits_();
}

function isOtemachiCampus_(value) {
  return String(value || '').replace(/[\s　]/g, '').indexOf('大手町') !== -1;
}

function requiredTextbookAvailableForProfile_(profile) {
  return !!profile && isOtemachiCampus_(profile.campus);
}

function filterUnitsForProfile_(profile, units) {
  return (units || []).filter(unit =>
    normalizeSeries_(unit.series) !== MATERIAL_SERIES.REQUIRED_TEXTBOOK ||
    requiredTextbookAvailableForProfile_(profile)
  );
}

